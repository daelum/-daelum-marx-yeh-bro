---
interface Props {
	/** Visual size preset */
	size?: 'nav' | 'md' | 'hero';
	/** Hide from assistive tech when a nearby text label already names the brand */
	decorative?: boolean;
	class?: string;
}

const { size = 'nav', decorative = false, class: className } = Astro.props;

/** Transparent PNG/WebP lockups — no black tile, no watermark. */
const srcBySize = {
	nav: '/brand/yehbro-logo-nav.webp',
	md: '/brand/yehbro-logo-md.webp',
	hero: '/brand/yehbro-logo.webp',
} as const;

/** Intrinsic pixel sizes of the exported lockups (721×920 source aspect). */
const widthBySize = {
	nav: 50,
	md: 126,
	hero: 728,
} as const;

const heightBySize = {
	nav: 64,
	md: 160,
	hero: 921,
} as const;
---

<img
	class:list={['brand-logo', `brand-logo--${size}`, className]}
	src={srcBySize[size]}
	width={widthBySize[size]}
	height={heightBySize[size]}
	alt={decorative ? '' : 'YehBro'}
	aria-hidden={decorative ? 'true' : undefined}
	decoding="async"
	fetchpriority={size === 'hero' ? 'high' : undefined}
/>

<style>
	.brand-logo {
		display: block;
		height: auto;
		width: auto;
		max-width: 100%;
		object-fit: contain;
		object-position: left center;
		/* Transparent mark — no box, no fill behind the spikes */
		background: transparent;
	}
	.brand-logo--nav {
		height: 2.5rem;
		width: auto;
		filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.45));
	}
	.brand-logo--md {
		height: 3.25rem;
		width: auto;
	}
	.brand-logo--hero {
		/* Tall spiked mark — height-led so it reads as brand, not a tile */
		height: clamp(8.5rem, 34vh, 16rem);
		width: auto;
		max-width: min(100%, 17.5rem);
		/* Soft depth only — avoid heavy black bloom that reads as a tile */
		filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.35));
	}
	@media (min-width: 720px) {
		.brand-logo--hero {
			max-width: min(100%, 20rem);
			height: clamp(10rem, 38vh, 17.5rem);
		}
	}
</style>
