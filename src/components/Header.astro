---
import BrandLogo from './BrandLogo.astro';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="wrap nav" aria-label="Primary">
		<a class="brand" href="/" aria-label="Yeh Bro home">
			<BrandLogo size="nav" decorative />
		</a>
		<button
			type="button"
			class="nav-toggle"
			aria-expanded="false"
			aria-controls="nav-menu"
			id="nav-toggle"
		>
			<span class="sr-only">Menu</span>
			<span class="nav-toggle-bars" aria-hidden="true"></span>
		</button>
		<div class="nav-menu" id="nav-menu">
			<HeaderLink href="/start-here">Yeh Bro System</HeaderLink>
			<HeaderLink href="/food-bro">Food Bro</HeaderLink>
			<HeaderLink href="/food">Food hub</HeaderLink>
			<HeaderLink href="/blog">Guides</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('nav-menu');
	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		menu?.classList.toggle('is-open', !open);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		backdrop-filter: blur(12px);
		background: rgba(10, 10, 10, 0.88);
		border-bottom: 1px solid var(--yb-edge);
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 4.25rem;
		gap: 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		color: var(--yb-offwhite);
		opacity: 0.96;
		transition: opacity 0.2s ease;
	}
	.brand:hover {
		color: var(--yb-offwhite);
		opacity: 1;
	}
	.nav-menu {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	.nav-menu :global(a) {
		color: rgba(242, 242, 240, 0.82);
		text-decoration: none;
		padding: 0.55rem 0.65rem;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.nav-menu :global(a:hover),
	.nav-menu :global(a.active) {
		color: var(--yb-lime);
	}
	.nav-toggle {
		display: none;
		background: transparent;
		border: 1px solid rgba(242, 242, 240, 0.25);
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		cursor: pointer;
		border-radius: 2px;
	}
	.nav-toggle-bars,
	.nav-toggle-bars::before,
	.nav-toggle-bars::after {
		display: block;
		width: 1.1rem;
		height: 2px;
		background: var(--yb-offwhite);
		margin: 0 auto;
		position: relative;
		content: '';
	}
	.nav-toggle-bars::before {
		position: absolute;
		top: -5px;
	}
	.nav-toggle-bars::after {
		position: absolute;
		top: 5px;
	}
	@media (max-width: 820px) {
		.nav-toggle {
			display: inline-grid;
			place-items: center;
		}
		.nav-menu {
			display: none;
			position: absolute;
			top: 4.25rem;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			background: var(--yb-surface);
			border-bottom: 1px solid var(--yb-edge);
			padding: 0.5rem 1rem 1rem;
		}
		.nav-menu.is-open {
			display: flex;
		}
	}
</style>
