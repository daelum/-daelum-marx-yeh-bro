---
import { OFFER_PRICE_NOTE } from '../data/products';

interface Props {
	/** Compact = single line for product heroes; hero = larger homepage treatment */
	variant?: 'hero' | 'compact';
	class?: string;
}

const { variant = 'compact', class: className } = Astro.props;
---

<p class:list={['free-offer', `free-offer--${variant}`, className]}>
	<span class="free-offer-now">Free</span>
	<span class="free-offer-sep" aria-hidden="true">·</span>
	<span class="free-offer-note">{OFFER_PRICE_NOTE}</span>
</p>

<style>
	.free-offer {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 0.55rem;
		margin: 0 0 0.85rem;
		font-family: var(--font-body);
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.free-offer-now {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--yb-lime);
		font-size: 1.15rem;
	}
	.free-offer-sep {
		color: rgba(242, 242, 240, 0.45);
		font-weight: 600;
		font-size: 0.95rem;
	}
	.free-offer-note {
		color: rgba(242, 242, 240, 0.78);
		font-weight: 600;
		font-size: 0.95rem;
	}
	.free-offer--hero .free-offer-now {
		font-size: clamp(1.35rem, 3vw, 1.85rem);
	}
	.free-offer--hero .free-offer-sep,
	.free-offer--hero .free-offer-note {
		font-size: 1.05rem;
	}
</style>
