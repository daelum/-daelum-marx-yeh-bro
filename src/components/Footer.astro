---
import BrandLogo from './BrandLogo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap footer-inner">
		<a class="footer-brand" href="/" aria-label="Yeh Bro home">
			<BrandLogo size="md" decorative />
		</a>
		<p class="footer-disclosure">
			Gym education · not medical advice.{' '}
			<a href="/disclosure">Disclosure</a>
			{' · '}
			<a href="/privacy">Privacy</a>
		</p>
		<nav class="footer-nav" aria-label="Footer">
			<a href="/start-here">Yeh Bro System</a>
			<a href="/food-bro">Food Bro</a>
			<a href="/food">Food hub</a>
			<a href="/start-here/training">Training templates</a>
			<a href="/start-here/weekly">Weekly checklist</a>
			<a href="/blog">Guides</a>
			<a href="/blog/ped-harm-reduction-australia">PED education</a>
			<a href="/about">About</a>
			<a href="/disclosure">Disclosure</a>
			<a href="/privacy">Privacy</a>
			<a href="/contact">Contact</a>
		</nav>
		<p class="footer-meta muted">
			© {year} Yeh Bro. Some links may earn a commission. As an Amazon Associate we earn from
			qualifying purchases.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding: 3rem 0 4rem;
		border-top: 1px solid var(--yb-edge);
		background:
			linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.55)),
			var(--noise);
	}
	.footer-inner {
		display: grid;
		gap: 1rem;
	}
	.footer-brand {
		display: inline-block;
		text-decoration: none;
		width: fit-content;
		opacity: 0.95;
		transition: opacity 0.2s ease;
	}
	.footer-brand:hover {
		opacity: 1;
	}
	.footer-disclosure {
		margin: 0;
		max-width: 36rem;
		color: rgba(242, 242, 240, 0.8);
		font-size: 0.98rem;
	}
	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin-top: 0.5rem;
	}
	.footer-nav a {
		color: var(--yb-muted);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 600;
	}
	.footer-nav a:hover {
		color: var(--yb-lime);
	}
	.footer-meta {
		margin: 0.75rem 0 0;
		font-size: 0.85rem;
	}
</style>
