---
interface Props {
	compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside class="disclosure-banner" role="note">
	{
		compact ? (
			<p>
				Some links may earn a commission.{' '}
				<a href="/disclosure">Disclosure</a>
			</p>
		) : (
			<p>
				Some product links may earn Yeh Bro a commission at no extra cost to you. Not medical
				advice. <a href="/disclosure">Disclosure</a>
			</p>
		)
	}
</aside>
<style>
	p {
		margin: 0;
	}
</style>
