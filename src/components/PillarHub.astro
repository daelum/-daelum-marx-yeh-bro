---
import type { Pillar } from '../data/pillars';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	pillar: Pillar;
	title?: string;
	description?: string;
}

const { pillar, title, description } = Astro.props;
const pageTitle = title ?? `${pillar.label} — Yeh Bro`;
const pageDescription = description ?? pillar.lede;
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath={pillar.href} fullBleed>
	<section class="pillar-hero">
		<div class="pillar-hero-atmosphere" aria-hidden="true"></div>
		<div class="wrap pillar-hero-inner">
			<p class="eyebrow anim-rise">{pillar.label}</p>
			<h1 class="anim-rise-delay">{pillar.tagline}</h1>
			<p class="lede anim-rise-delay">{pillar.lede}</p>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">In this lane</p>
		<ul class="guide-links">
			{
				pillar.links.map((link) => (
					<li>
						<a
							href={link.href}
							rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							target={link.href.startsWith('http') ? '_blank' : undefined}
						>
							{link.label}
							<span>{link.blurb}</span>
						</a>
					</li>
				))
			}
		</ul>
		<slot />
	</section>
</BaseLayout>

<style>
	.pillar-hero {
		position: relative;
		padding: 5rem 0 3rem;
		overflow: hidden;
		border-bottom: 1px solid var(--yb-edge);
	}
	.pillar-hero-atmosphere {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 50% 60% at 85% 20%, rgba(200, 241, 53, 0.07), transparent 55%),
			radial-gradient(ellipse 40% 50% at 10% 80%, rgba(154, 149, 136, 0.08), transparent 50%),
			linear-gradient(165deg, rgba(8, 8, 8, 0.2), rgba(8, 8, 8, 0.92)),
			var(--noise);
		pointer-events: none;
	}
	.pillar-hero-inner {
		position: relative;
		z-index: 1;
		max-width: 40rem;
	}
	.pillar-hero h1 {
		font-size: clamp(1.75rem, 4vw, 2.6rem);
		max-width: 18ch;
		text-wrap: balance;
	}
</style>
