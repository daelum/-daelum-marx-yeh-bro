---
/**
 * Strong medical / legal / no-sourcing disclaimer for PED / enhanced-culture education.
 * Reused site-wide on enhanced bodybuilding content (not a substitute for DisclosureNote).
 */
interface Props {
	/** Compact one-liner for hubs / nav surfaces. Full block is default. */
	compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside class="enhanced-disclaimer" role="note" aria-label="Medical and legal disclaimer">
	{
		compact ? (
			<p>
				<strong>Not medical advice.</strong> Yeh Bro educates on PED culture with harm reduction —
				we do <strong>not</strong> prescribe, sell, or source AAS / gear. AU: many AAS are
				prescription-only / controlled. See a doctor — not Yeh Bro.{' '}
				<a href="/blog/ped-harm-reduction-australia">PED education</a>
			</p>
		) : (
			<>
				<p>
					<strong>Medical / legal disclaimer (read this):</strong> Yeh Bro is <strong>not</strong>{' '}
					a doctor, pharmacist, lawyer, or prescribing clinic. Enhanced / PED pages are{' '}
					<strong>general education</strong> about bodybuilding culture — <strong>not</strong>{' '}
					medical advice, <strong>not</strong> a personal dosing protocol, and{' '}
					<strong>not</strong> encouragement to use illegal or unapproved substances. Health
					decisions belong with a qualified clinician who knows your history.
				</p>
				<p>
					<strong>Australia:</strong> Many anabolic-androgenic steroids (AAS) are prescription-only
					and tightly controlled. Possession, supply, and importation can carry serious
					consequences. This is <strong>not legal advice</strong> — verify with official sources
					and independent counsel. <strong>We do not sell, source, or affiliate-link AAS,
					SARMs, unapproved peptides, aromatase inhibitors, SERMs, or underground gear.</strong>
				</p>
				<p>
					Where pages mention amounts or schedules, they describe{' '}
					<strong>patterns discussed in enhanced gym culture</strong> for literacy and risk
					context — <strong>not</strong> instructions from Yeh Bro. Prefer bloodwork and clinical
					care before any escalation. Crisis: emergency services or{' '}
					<a href="https://www.lifeline.org.au/" rel="noopener noreferrer">Lifeline</a> (13 11
					14). Substance info:{' '}
					<a href="https://adf.org.au/" rel="noopener noreferrer">Alcohol and Drug Foundation</a>.
					Harm-reduction peers (not affiliated):{' '}
					<a href="https://roidsafe.com.au" rel="noopener noreferrer">RoidSafe</a> ·{' '}
					<a href="https://pedtestaustralia.com/" rel="noopener noreferrer">PED Test AU</a>. Full
					context: <a href="/blog/ped-harm-reduction-australia">PED harm reduction (AU)</a>.
				</p>
			</>
		)
	}
</aside>

<style>
	.enhanced-disclaimer {
		margin: 1.25rem 0 1.75rem;
		padding: 1rem 1.1rem;
		border-left: 3px solid var(--yb-teal);
		background: rgba(0, 180, 166, 0.08);
		border-radius: 0 4px 4px 0;
		font-size: 0.95rem;
		line-height: 1.55;
		color: rgba(242, 242, 240, 0.92);
	}
	.enhanced-disclaimer p {
		margin: 0 0 0.75rem;
	}
	.enhanced-disclaimer p:last-child {
		margin-bottom: 0;
	}
	.enhanced-disclaimer a {
		color: var(--yb-lime);
		font-weight: 600;
	}
</style>
