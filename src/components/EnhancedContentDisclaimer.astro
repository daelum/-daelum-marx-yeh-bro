---
/**
 * Light education note for PED / enhanced-culture posts.
 * One short line — not a lawyer megaphone. Full context lives in the PED hub.
 */
interface Props {
	/** Same short line either way; compact kept for call-site compatibility. */
	compact?: boolean;
}
const { compact: _compact = false } = Astro.props;
---

<aside class="enhanced-disclaimer" role="note" aria-label="Education note">
	<p>
		Education, not a personal protocol — bloodwork and medical calls stay with a clinician who knows
		you. We don’t source gear.{' '}
		<a href="/blog/ped-harm-reduction-australia">PED guide</a>
	</p>
</aside>

<style>
	.enhanced-disclaimer {
		margin: 1rem 0 1.5rem;
		padding: 0.75rem 0 0.75rem 0.95rem;
		border-left: 3px solid var(--yb-teal);
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--yb-muted);
	}
	.enhanced-disclaimer p {
		margin: 0;
	}
	.enhanced-disclaimer a {
		color: var(--yb-lime);
		font-weight: 600;
	}
</style>
