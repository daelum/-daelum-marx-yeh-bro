---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
	title="Guides"
	description="Yeh Bro guides: training, food, creatine, protein, bodybuilding blueprint, and optional PED culture literacy."
>
	<section class="wrap blog-index">
		<p class="eyebrow">Guides</p>
		<h1>Guides for the work.</h1>
		<p class="lede">
			New? Start with the numbered path on <a href="/start-here">Start here</a>. Everything below is
			depth when you need it — training phases, scoop maths, culture literacy.
		</p>
		<ul class="guide-links">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							{post.data.title}
							<span>
								<FormattedDate date={post.data.pubDate} /> — {post.data.description}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.blog-index {
		padding-bottom: 3rem;
	}
</style>
