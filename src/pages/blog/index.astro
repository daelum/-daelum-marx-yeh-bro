---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
	title="Guides"
	description="Yeh Bro guides: PED harm reduction, bodybuilding culture, creatine, protein, and pre — Australia-first."
>
	<section class="wrap blog-index">
		<p class="eyebrow">Guides</p>
		<h1>Culture first. Evidence always.</h1>
		<p class="lede">
			PED harm reduction and bodybuilding literacy, plus AU sports-nutrition maths. Affiliate
			<code>/go/</code> links stay legal products only — see disclosure on each post.
		</p>
		<ul class="guide-links">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							{post.data.title}
							<span>
								<FormattedDate date={post.data.pubDate} /> — {post.data.description}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.blog-index {
		padding-bottom: 3rem;
	}
</style>
