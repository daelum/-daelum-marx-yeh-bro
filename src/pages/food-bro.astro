---
import BaseLayout from '../layouts/BaseLayout.astro';
import FreeOffer from '../components/FreeOffer.astro';
import ProductPath from '../components/ProductPath.astro';
import {
	ACTIVITY_LABELS,
	COACH_DAY_PLANS,
	COACH_PLAN_EXAMPLE_PROFILE,
	GOAL_DEFAULTS,
	MEAL_FRAMEWORKS,
	type Activity,
	type Goal,
} from '../lib/food-os';

const activities = Object.entries(ACTIVITY_LABELS) as [Activity, string][];
const goals = Object.entries(GOAL_DEFAULTS) as [Goal, (typeof GOAL_DEFAULTS)[Goal]][];
const { age, weightKg, heightCm } = COACH_PLAN_EXAMPLE_PROFILE;
---

<BaseLayout
	title="Food Bro — calories & macros"
	description="Food Bro: free calorie and macro calculator plus recommended coach day templates — non-training, training, and diet break."
	canonicalPath="/food-bro"
>
	<ProductPath
		crumbs={[
			{ href: '/start-here', label: 'Yeh Bro System' },
			{ href: '/food-bro', label: 'Food Bro', current: true },
			{ href: '/food-bro/shopping', label: 'Shopping' },
			{ href: '/food', label: 'Food hub' },
		]}
	/>

	<article class="wrap food-os-page">
		<header class="fos-hero">
			<p class="eyebrow anim-rise">Yeh Bro System · Phase 4</p>
			<h1 class="anim-rise fos-name">Food Bro</h1>
			<div class="anim-rise">
				<FreeOffer />
			</div>
			<p class="lede anim-rise-delay">
				Set daily calories and macros for a cut, maintain, or lean bulk — then run the recommended
				coach day templates: non-training, training, or a 1–2 week diet break (~maintenance when
				you’re flat). Inputs stick in this browser.
			</p>
		</header>

		<div class="fos-grid">
			<form id="fos-form" class="fos-form" novalidate>
				<fieldset class="fos-fieldset">
					<legend>Body</legend>
					<div class="fos-fields">
						<label class="fos-field">
							<span>Body weight (kg)</span>
							<input
								type="number"
								name="weightKg"
								id="weightKg"
								inputmode="decimal"
								min="35"
								max="250"
								step="0.1"
								required
							/>
						</label>
						<label class="fos-field">
							<span>Height (cm)</span>
							<input
								type="number"
								name="heightCm"
								id="heightCm"
								inputmode="numeric"
								min="120"
								max="230"
								step="1"
								required
							/>
						</label>
						<label class="fos-field">
							<span>Age</span>
							<input
								type="number"
								name="age"
								id="age"
								inputmode="numeric"
								min="16"
								max="90"
								step="1"
								required
							/>
						</label>
						<fieldset class="fos-seg" id="sex-field">
							<legend class="fos-seg-legend">Sex (for resting estimate)</legend>
							<label class="seg-opt">
								<input type="radio" name="sex" value="male" />
								<span>Male</span>
							</label>
							<label class="seg-opt">
								<input type="radio" name="sex" value="female" />
								<span>Female</span>
							</label>
						</fieldset>
					</div>
					<p class="fos-note muted">
						Sex feeds the Mifflin–St Jeor resting estimate only — a starting point, not identity
						politics or a prescription.
					</p>
				</fieldset>

				<fieldset class="fos-fieldset">
					<legend>Activity & goal</legend>
					<label class="fos-field fos-field-full">
						<span>Activity</span>
						<select name="activity" id="activity" required>
							{
								activities.map(([value, label]) => (
									<option value={value}>{label}</option>
								))
							}
						</select>
					</label>

					<fieldset class="fos-seg fos-goals" id="goal-field">
						<legend class="fos-seg-legend">Goal</legend>
						{
							goals.map(([value, meta]) => (
								<label class="seg-opt">
									<input type="radio" name="goal" value={value} />
									<span>
										<strong>{meta.label}</strong>
										<small>{meta.blurb}</small>
									</span>
								</label>
							))
						}
					</fieldset>

					<label class="fos-field fos-field-full" id="adj-wrap" hidden>
						<span id="adj-label">Adjustment</span>
						<input type="range" name="adjustment" id="adjustment" min="10" max="25" step="1" />
						<span class="adj-readout" id="adj-readout"></span>
					</label>

					<fieldset class="fos-seg fos-training" id="training-field">
						<legend class="fos-seg-legend">Training days (Yeh Bro System)</legend>
						<label class="seg-opt">
							<input type="radio" name="trainingDays" value="3" />
							<span>
								<strong>3-day PPL</strong>
								<small>Push / Pull / Legs — default when life is busy.</small>
							</span>
						</label>
						<label class="seg-opt">
							<input type="radio" name="trainingDays" value="4" />
							<span>
								<strong>4-day PPLU</strong>
								<small>Add Upper when recovery and schedule allow.</small>
							</span>
						</label>
					</fieldset>
				</fieldset>

				<div class="fos-actions">
					<button type="submit" class="btn btn-primary">Update targets</button>
					<button type="button" class="btn btn-secondary" id="fos-reset">Reset defaults</button>
				</div>
				<p class="fos-save-note muted" id="fos-save-note" aria-live="polite"></p>
			</form>

			<div class="fos-results" id="fos-results" aria-live="polite">
				<p class="eyebrow">Your targets</p>
				<p class="fos-empty" id="fos-empty">Enter your details — targets appear here.</p>
				<div id="fos-output" hidden>
					<p class="fos-cal">
						<span class="fos-cal-num" id="out-cal">—</span>
						<span class="fos-cal-unit">kcal / day</span>
					</p>
					<p class="fos-tdee muted" id="out-tdee"></p>
					<ul class="macro-row">
						<li>
							<span class="macro-val" id="out-p">—</span>
							<span class="macro-lab">Protein</span>
						</li>
						<li>
							<span class="macro-val" id="out-c">—</span>
							<span class="macro-lab">Carbs</span>
						</li>
						<li>
							<span class="macro-val" id="out-f">—</span>
							<span class="macro-lab">Fat</span>
						</li>
					</ul>
					<div class="why-box">
						<p class="why-title">Why these numbers</p>
						<ul id="out-why"></ul>
					</div>
				</div>
			</div>
		</div>

		<section class="fos-plans" id="recommended-plans">
			<p class="eyebrow">Recommended</p>
			<h2>Coach day templates</h2>
			<p class="lede" id="plans-lede">
				Day structures from the coach templates (baseline {age} / {weightKg} kg / {heightCm} cm).
				Your calculator sets the kcal and portions — pick a day type below.
			</p>
			<div class="plan-meta" id="plans-meta" aria-live="polite">
				<p class="plan-profile-line" id="plans-profile-line"></p>
				<p class="plan-profile-note muted" id="plans-profile-note" hidden></p>
			</div>

			<div class="plan-tabs" role="tablist" aria-label="Day type">
				{
					COACH_DAY_PLANS.map((plan, i) => (
						<button
							type="button"
							class:list={['plan-tab', i === 0 && 'is-active']}
							role="tab"
							id={`tab-${plan.id}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-controls={`panel-${plan.id}`}
							data-plan-tab={plan.id}
						>
							{plan.title}
						</button>
					))
				}
			</div>

			{
				COACH_DAY_PLANS.map((plan, i) => (
					<div
						class:list={['plan-panel', i === 0 && 'is-active']}
						role="tabpanel"
						id={`panel-${plan.id}`}
						aria-labelledby={`tab-${plan.id}`}
						hidden={i !== 0}
						data-plan-panel={plan.id}
					>
						{/* Filled / refreshed by Food Bro script from scaled templates */}
					</div>
				))
			}

			<p class="plan-shop-cta">
				<a class="btn btn-secondary" href="/food-bro/shopping">Weekly shopping list</a>
			</p>
		</section>

		<section class="fos-pdf" id="personal-plan">
			<p class="eyebrow">Download</p>
			<h2>Personalized plan (PDF)</h2>
			<p class="lede">
				One print-ready pack: where you are now, goal + timeframe, Yeh Bro System training (PPL /
				PPLU), scaled nutrition day templates, a 12-week block, and a recommended next phase after
				week 12. Save as PDF from the print dialog — no account, no backend.
			</p>
			<div class="fos-actions">
				<a class="btn btn-primary" id="fos-pdf-link" href="/food-bro/plan">Download personalized PDF</a>
				<a class="btn btn-secondary" href="/start-here/training">Training templates</a>
			</div>
			<p class="fos-pdf-gate muted" id="fos-pdf-gate" aria-live="polite"></p>
		</section>

		<section class="fos-meals" id="meals">
			<p class="eyebrow">Also useful</p>
			<h2>Soft plate heuristics</h2>
			<p class="lede">
				When you’re off the coach template or need protein without an app spiral.
			</p>
			{
				MEAL_FRAMEWORKS.map((fw) => (
					<div class="meal-fw">
						<h3>{fw.title}</h3>
						<p class="muted meal-when">{fw.when}</p>
						<ul>
							{fw.plates.map((p) => (
								<li>{p}</li>
							))}
						</ul>
					</div>
				))
			}
		</section>

		<section class="fos-next">
			<p class="eyebrow">In the system</p>
			<h2>Food is phase 4 — not the whole plan</h2>
			<p class="lede">
				Pair this with training templates and the weekly checklist. Deeper reads live on the food
				hub when you want depth.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="/start-here">Yeh Bro System</a>
				<a class="btn btn-secondary" href="/start-here/weekly">Weekly checklist</a>
				<a class="btn btn-secondary" href="/food-bro/shopping">Shopping list</a>
				<a class="btn btn-secondary" href="/food">Food hub</a>
			</div>
			<p class="compliance muted">
				Education only — not medical advice or a personal prescription. Estimates vary; adjust from
				your scale trend and how training feels. Under 18 or clinical conditions → talk to a
				clinician.
			</p>
		</section>
	</article>
</BaseLayout>

<script>
	import {
		DEFAULT_INPUTS,
		GOAL_DEFAULTS,
		STORAGE_KEY,
		calcFoodOs,
		scaleCoachDayPlans,
		type Activity,
		type CoachDayPlan,
		type Goal,
		type Sex,
		type StoredFoodOs,
		type TrainingDaysPref,
	} from '../lib/food-os';

	const form = document.getElementById('fos-form') as HTMLFormElement | null;
	const adjWrap = document.getElementById('adj-wrap') as HTMLLabelElement | null;
	const adjInput = document.getElementById('adjustment') as HTMLInputElement | null;
	const adjLabel = document.getElementById('adj-label');
	const adjReadout = document.getElementById('adj-readout');
	const saveNote = document.getElementById('fos-save-note');
	const empty = document.getElementById('fos-empty');
	const output = document.getElementById('fos-output');
	const plansLede = document.getElementById('plans-lede');
	const plansProfileLine = document.getElementById('plans-profile-line');
	const plansProfileNote = document.getElementById('plans-profile-note');
	const pdfLink = document.getElementById('fos-pdf-link') as HTMLAnchorElement | null;
	const pdfGate = document.getElementById('fos-pdf-gate');

	function readStored(): StoredFoodOs {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (raw) {
				const parsed = JSON.parse(raw) as Partial<StoredFoodOs>;
				return { ...DEFAULT_INPUTS, ...parsed };
			}
		} catch {
			/* ignore */
		}
		return { ...DEFAULT_INPUTS };
	}

	function writeStored(data: StoredFoodOs) {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
		if (saveNote) saveNote.textContent = 'Saved on this device.';
	}

	function selectedRadio(name: string): string | null {
		const el = form?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
		return el?.value ?? null;
	}

	function applyToForm(data: StoredFoodOs) {
		if (!form) return;
		(form.elements.namedItem('weightKg') as HTMLInputElement).value = String(data.weightKg);
		(form.elements.namedItem('heightCm') as HTMLInputElement).value = String(data.heightCm);
		(form.elements.namedItem('age') as HTMLInputElement).value = String(data.age);
		(form.elements.namedItem('activity') as HTMLSelectElement).value = data.activity;
		const sex = form.querySelector<HTMLInputElement>(`input[name="sex"][value="${data.sex}"]`);
		if (sex) sex.checked = true;
		const goal = form.querySelector<HTMLInputElement>(`input[name="goal"][value="${data.goal}"]`);
		if (goal) goal.checked = true;
		const days = data.trainingDays === 4 ? '4' : '3';
		const td = form.querySelector<HTMLInputElement>(`input[name="trainingDays"][value="${days}"]`);
		if (td) td.checked = true;
		syncAdjustmentUi(data);
	}

	function syncAdjustmentUi(data: StoredFoodOs) {
		if (!adjWrap || !adjInput || !adjLabel || !adjReadout) return;
		if (data.goal === 'maintain') {
			adjWrap.hidden = true;
			return;
		}
		adjWrap.hidden = false;
		if (data.goal === 'cut') {
			adjInput.min = '10';
			adjInput.max = '25';
			adjInput.value = String(data.cutPct);
			adjLabel.textContent = 'Deficit (% below maintenance)';
			adjReadout.textContent = `−${data.cutPct}%`;
		} else {
			adjInput.min = '5';
			adjInput.max = '15';
			adjInput.value = String(data.bulkPct);
			adjLabel.textContent = 'Surplus (% above maintenance)';
			adjReadout.textContent = `+${data.bulkPct}%`;
		}
	}

	function collect(): StoredFoodOs | null {
		if (!form) return null;
		const weightKg = Number((form.elements.namedItem('weightKg') as HTMLInputElement).value);
		const heightCm = Number((form.elements.namedItem('heightCm') as HTMLInputElement).value);
		const age = Number((form.elements.namedItem('age') as HTMLInputElement).value);
		const sex = selectedRadio('sex') as Sex | null;
		const activity = (form.elements.namedItem('activity') as HTMLSelectElement).value as Activity;
		const goal = selectedRadio('goal') as Goal | null;
		const trainingRaw = selectedRadio('trainingDays');
		const trainingDays = (trainingRaw === '4' ? 4 : 3) as TrainingDaysPref;
		if (!sex || !goal) return null;
		const prev = readStored();
		const cutPct =
			goal === 'cut' && adjInput ? Number(adjInput.value) || prev.cutPct : prev.cutPct;
		const bulkPct =
			goal === 'lean-bulk' && adjInput ? Number(adjInput.value) || prev.bulkPct : prev.bulkPct;
		return { weightKg, heightCm, age, sex, activity, goal, cutPct, bulkPct, trainingDays };
	}

	function profileReady(data: StoredFoodOs): boolean {
		return (
			Number.isFinite(data.weightKg) &&
			Number.isFinite(data.heightCm) &&
			Number.isFinite(data.age) &&
			data.weightKg >= 35 &&
			data.heightCm >= 120 &&
			data.age >= 16
		);
	}

	function syncPdfGate(data: StoredFoodOs, ok: boolean) {
		if (!pdfLink || !pdfGate) return;
		if (ok && profileReady(data)) {
			pdfLink.classList.remove('is-disabled');
			pdfLink.removeAttribute('aria-disabled');
			pdfLink.href = '/food-bro/plan';
			pdfGate.textContent = 'Ready — opens a print view; choose Save as PDF.';
		} else {
			pdfLink.classList.add('is-disabled');
			pdfLink.setAttribute('aria-disabled', 'true');
			pdfLink.href = '#personal-plan';
			pdfGate.textContent = 'Complete your profile first — height, weight, age, activity, and goal.';
		}
	}

	function renderPlanPanel(panel: HTMLElement, plan: CoachDayPlan) {
		const meals = plan.meals
			.map((meal) => {
				const ings =
					meal.ingredients && meal.ingredients.length > 0
						? `<div class="plan-ings" role="list">${meal.ingredients
								.map(
									(ing) =>
										`<div class="plan-ing" role="listitem"><span class="plan-ing-name">${ing.name}${ing.note ? ` <em class="muted">${ing.note}</em>` : ''}</span><span class="plan-ing-amt">${ing.amount}</span></div>`,
								)
								.join('')}</div>`
						: '';
				return `<article class="plan-meal${meal.intra ? ' is-intra' : ''}">
					<header class="plan-meal-head">
						<h3 class="plan-meal-name">${meal.name}</h3>
						<p class="plan-meal-kcal muted">${meal.kcal} kcal</p>
					</header>
					<ul class="plan-meal-macros" aria-label="Meal macros">
						<li><span class="m-lab">P</span><span class="m-val">${meal.proteinG}g</span></li>
						<li><span class="m-lab">C</span><span class="m-val">${meal.carbsG}g</span></li>
						<li><span class="m-lab">F</span><span class="m-val">${meal.fatG}g</span></li>
					</ul>
					${ings}
				</article>`;
			})
			.join('');
		panel.innerHTML = `
			<p class="plan-when muted">${plan.when}</p>
			<div class="plan-day-summary">
				<p class="plan-cal"><span class="plan-cal-num">${plan.calories}</span><span class="plan-cal-unit">kcal</span></p>
				<ul class="plan-macro-grid" aria-label="Day macros">
					<li><span class="macro-val">${plan.proteinG}g</span><span class="macro-lab">Protein · ${plan.proteinPct}%</span></li>
					<li><span class="macro-val">${plan.carbsG}g</span><span class="macro-lab">Carbs · ${plan.carbsPct}%</span></li>
					<li><span class="macro-val">${plan.fatG}g</span><span class="macro-lab">Fat · ${plan.fatPct}%</span></li>
					<li><span class="macro-val">${plan.fibreG}g</span><span class="macro-lab">Fibre</span></li>
				</ul>
			</div>
			<div class="plan-meals">${meals}</div>
		`;
	}

	function renderPlans(data: StoredFoodOs, result: NonNullable<ReturnType<typeof calcFoodOs>>) {
		const scaled = scaleCoachDayPlans(result, {
			weightKg: data.weightKg,
			heightCm: data.heightCm,
			age: data.age,
		});
		if (plansLede) plansLede.textContent = scaled.lede;
		if (plansProfileLine) plansProfileLine.textContent = scaled.profileLine;
		if (plansProfileNote) {
			if (scaled.profileNote) {
				plansProfileNote.hidden = false;
				plansProfileNote.textContent = scaled.profileNote;
			} else {
				plansProfileNote.hidden = true;
				plansProfileNote.textContent = '';
			}
		}
		scaled.plans.forEach((plan) => {
			const panel = document.querySelector<HTMLElement>(`[data-plan-panel="${plan.id}"]`);
			if (panel) renderPlanPanel(panel, plan);
		});
	}

	function render(data: StoredFoodOs) {
		const adjustment =
			data.goal === 'cut'
				? -(data.cutPct / 100)
				: data.goal === 'lean-bulk'
					? data.bulkPct / 100
					: 0;
		const result = calcFoodOs({
			weightKg: data.weightKg,
			heightCm: data.heightCm,
			age: data.age,
			sex: data.sex,
			activity: data.activity,
			goal: data.goal,
			adjustment,
		});
		if (!result) {
			empty && (empty.hidden = false);
			output && (output.hidden = true);
			if (empty) empty.textContent = 'Check the inputs — weight, height, and age need to be in range.';
			syncPdfGate(data, false);
			return;
		}
		if (empty) empty.hidden = true;
		if (output) output.hidden = false;
		const set = (id: string, text: string) => {
			const el = document.getElementById(id);
			if (el) el.textContent = text;
		};
		set('out-cal', String(result.calories));
		set(
			'out-tdee',
			`Est. maintenance ≈ ${result.tdee} kcal · resting ≈ ${result.bmr} kcal · ${GOAL_DEFAULTS[data.goal].label}`,
		);
		set('out-p', `${result.proteinG} g`);
		set('out-c', `${result.carbsG} g`);
		set('out-f', `${result.fatG} g`);
		const why = document.getElementById('out-why');
		if (why) {
			why.innerHTML = '';
			result.why.forEach((line) => {
				const li = document.createElement('li');
				li.textContent = line;
				why.appendChild(li);
			});
		}
		renderPlans(data, result);
		syncPdfGate(data, true);
	}

	function refresh() {
		const data = collect();
		if (!data) {
			syncPdfGate(DEFAULT_INPUTS, false);
			return;
		}
		syncAdjustmentUi(data);
		writeStored(data);
		render(data);
	}

	const initial = readStored();
	applyToForm(initial);
	render(initial);
	if (saveNote && localStorage.getItem(STORAGE_KEY)) {
		saveNote.textContent = 'Loaded your last saved setup.';
	}

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		refresh();
	});
	form?.addEventListener('change', () => refresh());
	adjInput?.addEventListener('input', () => {
		const data = collect();
		if (!data || !adjReadout) return;
		if (data.goal === 'cut') adjReadout.textContent = `−${adjInput.value}%`;
		else if (data.goal === 'lean-bulk') adjReadout.textContent = `+${adjInput.value}%`;
		refresh();
	});

	document.getElementById('fos-reset')?.addEventListener('click', () => {
		const defaults = { ...DEFAULT_INPUTS };
		applyToForm(defaults);
		writeStored(defaults);
		render(defaults);
		if (saveNote) saveNote.textContent = 'Reset to defaults.';
	});

	pdfLink?.addEventListener('click', (e) => {
		if (pdfLink.getAttribute('aria-disabled') === 'true') {
			e.preventDefault();
			if (pdfGate) pdfGate.textContent = 'Complete your profile first — height, weight, age, activity, and goal.';
		}
	});

	const planTabs = document.querySelectorAll<HTMLButtonElement>('[data-plan-tab]');
	const planPanels = document.querySelectorAll<HTMLElement>('[data-plan-panel]');
	planTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const id = tab.dataset.planTab;
			planTabs.forEach((t) => {
				const on = t.dataset.planTab === id;
				t.classList.toggle('is-active', on);
				t.setAttribute('aria-selected', on ? 'true' : 'false');
			});
			planPanels.forEach((panel) => {
