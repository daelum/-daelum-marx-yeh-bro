---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Your Yeh Bro plan — print / PDF"
	description="Your personalised Yeh Bro training + nutrition plan — print or save as PDF."
	funnel
	canonicalPath="/plan"
>
	<article class="wrap plan-page" id="plan-page">
		<header class="plan-screen-only">
			<p class="eyebrow">Personalised plan</p>
			<h1>Your plan</h1>
			<p class="lede" id="gate-msg">Loading your stats…</p>
			<div class="cta-row" id="plan-actions" hidden>
				<button type="button" class="btn btn-primary" id="btn-print">Save as PDF / Print</button>
				<a class="btn btn-secondary" href="/#intake">Edit stats</a>
			</div>
			<p class="muted print-hint" id="print-hint" hidden>
				In the print dialog, choose <strong>Save as PDF</strong> and enable background graphics if
				you want the dark Yeh Bro look.
			</p>
		</header>

		<div id="plan-missing" class="plan-missing" hidden>
			<p class="lede">
				Enter your stats first — height, weight, age, activity, and goal — then come back for your
				PDF.
			</p>
			<a class="btn btn-primary" href="/#intake">Enter your stats</a>
		</div>

		<div id="plan-doc" class="plan-doc" hidden>
			<!-- Filled client-side from local profile + plan engines -->
		</div>
	</article>
</BaseLayout>

<script>
	import { ACTIVITY_LABELS, GOAL_DEFAULTS, type TrainingDaysPref } from '../lib/food-os';
	import { buildPersonalPlan, type PersonalPlanDoc } from '../lib/personal-plan';
	import {
		isProfileReady,
		readProfile,
		scaleResultFromProfile,
		toStoredFoodOs,
	} from '../lib/user-store';

	function esc(s: string): string {
		return s
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;');
	}

	function renderDoc(doc: PersonalPlanDoc): string {
		const adj =
			doc.profile.goal === 'cut'
				? `−${doc.profile.cutPct}% deficit`
				: doc.profile.goal === 'lean-bulk'
					? `+${doc.profile.bulkPct}% surplus`
					: 'at maintenance';

		const trainingDays = doc.training.days
			.map(
				(day) => `
			<section class="pd-day">
				<h3>${esc(day.label)}</h3>
				<table>
					<thead><tr><th>Lift</th><th>Sets</th><th>Reps</th></tr></thead>
					<tbody>
						${day.lifts
							.map(
								(l) => `<tr>
							<td>${esc(l.name)}${l.notes ? `<span class="note"> — ${esc(l.notes)}</span>` : ''}</td>
							<td>${esc(l.sets)}</td>
							<td>${esc(l.reps)}</td>
						</tr>`,
							)
							.join('')}
					</tbody>
				</table>
			</section>`,
			)
			.join('');

		const nutrition = doc.nutritionDays
			.map((plan) => {
				const meals = plan.meals
					.map(
						(m) => `
					<article class="pd-meal">
						<header class="pd-meal-head">
							<h4>${esc(m.name)}</h4>
							<span class="muted">${m.kcal} kcal · P ${m.proteinG}g · C ${m.carbsG}g · F ${m.fatG}g</span>
						</header>
						${
							m.ingredients?.length
								? `<table class="pd-ing-table">
									<thead>
										<tr>
											<th>Food</th>
											<th>Amount</th>
											<th>kcal</th>
											<th>P</th>
											<th>C</th>
											<th>F</th>
										</tr>
									</thead>
									<tbody>
										${m.ingredients
											.map(
												(i) => `<tr>
											<td>${esc(i.name)}${i.note ? `<span class="note"> — ${esc(i.note)}</span>` : ''}</td>
											<td>${esc(i.amount)}</td>
											<td>${i.kcal ?? '—'}</td>
											<td>${i.proteinG != null ? `${i.proteinG}g` : '—'}</td>
											<td>${i.carbsG != null ? `${i.carbsG}g` : '—'}</td>
											<td>${i.fatG != null ? `${i.fatG}g` : '—'}</td>
										</tr>`,
											)
											.join('')}
										<tr class="pd-ing-total">
											<td colspan="2">Meal total</td>
											<td>${m.kcal}</td>
											<td>${m.proteinG}g</td>
											<td>${m.carbsG}g</td>
											<td>${m.fatG}g</td>
										</tr>
									</tbody>
								</table>`
								: `<ul class="pd-meal-macros">
									<li><span class="m-lab">P</span> ${m.proteinG}g</li>
									<li><span class="m-lab">C</span> ${m.carbsG}g</li>
									<li><span class="m-lab">F</span> ${m.fatG}g</li>
								</ul>`
						}
					</article>`,
					)
					.join('');
				return `
				<section class="pd-nutri">
					<h3>${esc(plan.title)}</h3>
					<p class="muted">${esc(plan.when)}</p>
					<p class="pd-day-cal"><span class="pd-cal-num">${plan.calories}</span> <span class="muted">kcal</span></p>
					<ul class="pd-macro-grid">
						<li><span class="val">${plan.proteinG}g</span><span class="lab">Protein · ${plan.proteinPct}%</span></li>
						<li><span class="val">${plan.carbsG}g</span><span class="lab">Carbs · ${plan.carbsPct}%</span></li>
						<li><span class="val">${plan.fatG}g</span><span class="lab">Fat · ${plan.fatPct}%</span></li>
						<li><span class="val">${plan.fibreG}g</span><span class="lab">Fibre</span></li>
					</ul>
					<div class="pd-meals">${meals}</div>
				</section>`;
			})
			.join('');

		const shoppingRows = doc.shopping.lines
			.map(
				(line) => `
			<tr>
				<td>${esc(line.name)}${line.note ? `<span class="note"> — ${esc(line.note)}</span>` : ''}</td>
				<td class="pd-ing-amt">${esc(line.amount)}</td>
			</tr>`,
			)
			.join('');

		const blocks = doc.twelveWeek
			.map(
				(b) => `
			<section class="pd-block">
				<h3>${esc(b.weeks)} — ${esc(b.title)}</h3>
				<ul>${b.focus.map((f) => `<li>${esc(f)}</li>`).join('')}</ul>
			</section>`,
			)
			.join('');

		return `
			<header class="pd-hero">
				<p class="eyebrow">Yeh Bro · Personalised plan</p>
				<h1>Your plan</h1>
				<p class="tag">${esc(doc.goalFraming.headline)}</p>
				<p class="muted">Generated ${esc(doc.generatedAt)} · yehbro.com</p>
			</header>

			<section class="pd-section" id="where-now">
				<p class="eyebrow">1 · Where you are now</p>
				<h2>Current stats</h2>
				<ul class="stat-grid">
					<li><span class="lab">Weight</span><span class="val">${doc.profile.weightKg} kg</span></li>
					<li><span class="lab">Height</span><span class="val">${doc.profile.heightCm} cm</span></li>
					<li><span class="lab">Age</span><span class="val">${doc.profile.age}</span></li>
					<li><span class="lab">Sex (BMR)</span><span class="val">${esc(doc.profile.sex)}</span></li>
					<li><span class="lab">Activity</span><span class="val">${esc(doc.profile.activityLabel)}</span></li>
					<li><span class="lab">Goal</span><span class="val">${esc(doc.profile.goalLabel)} (${esc(adj)})</span></li>
					${
						doc.profile.goalWeightKg != null
							? `<li><span class="lab">Goal weight</span><span class="val">${doc.profile.goalWeightKg} kg</span></li>`
							: ''
					}
				</ul>
				<p class="targets">
					<strong>~${doc.targets.calories} kcal / day</strong>
					· P ${doc.targets.proteinG}g · C ${doc.targets.carbsG}g · F ${doc.targets.fatG}g
					· Est. maintenance ≈ ${doc.targets.tdee} kcal · resting ≈ ${doc.targets.bmr} kcal
					${doc.targets.source === 'user' ? ' · <em>your entered targets</em>' : ''}
				</p>
				${
					doc.dietaryNote
						? `<p class="muted">${esc(doc.dietaryNote)}</p>`
						: ''
				}
			</section>

			<section class="pd-section" id="goal-plan">
				<p class="eyebrow">2 · Goal + timeframe + plan</p>
				<h2>${esc(doc.goalFraming.headline)}</h2>
				<p>${esc(doc.goalFraming.timeframe)}</p>
				<ul>${doc.goalFraming.schedule.map((s) => `<li>${esc(s)}</li>`).join('')}</ul>
			</section>

			<section class="pd-section" id="training">
				<p class="eyebrow">3 · Training</p>
				<h2>${esc(doc.training.name)}</h2>
				<p>${esc(doc.training.blurb)}</p>
				<p class="muted">${doc.training.daysPerWeek} days · ${esc(doc.training.level)}</p>
				${trainingDays}
				<h3>Progression</h3>
				<ul>${doc.training.progression.map((r) => `<li>${esc(r)}</li>`).join('')}</ul>
			</section>

			<section class="pd-section" id="nutrition">
				<p class="eyebrow">4 · Nutrition</p>
				<h2>Your day templates</h2>
				<p>${esc(doc.nutritionLede)}</p>
				<p class="muted">${esc(doc.nutritionProfileLine)}</p>
				${doc.nutritionProfileNote ? `<p class="muted">${esc(doc.nutritionProfileNote)}</p>` : ''}
				${nutrition}
			</section>

			<section class="pd-section" id="shopping">
				<p class="eyebrow">5 · Shopping list</p>
				<h2>${esc(doc.shopping.title)}</h2>
				<p>${esc(doc.shopping.blurb)}</p>
				<table class="pd-shop-table">
					<thead><tr><th>Item</th><th>Amount</th></tr></thead>
					<tbody>${shoppingRows}</tbody>
				</table>
			</section>

			<section class="pd-section" id="twelve">
				<p class="eyebrow">6 · 12-week plan</p>
				<h2>Structured block</h2>
				${blocks}
			</section>

			<section class="pd-section" id="next">
				<p class="eyebrow">7 · End of 12 weeks</p>
				<h2>${esc(doc.nextPhase.title)}</h2>
				<p>${esc(doc.nextPhase.summary)}</p>
				<ul>${doc.nextPhase.bullets.map((b) => `<li>${esc(b)}</li>`).join('')}</ul>
			</section>

			<footer class="pd-foot">
				<p>${esc(doc.disclaimer)}</p>
			</footer>
		`;
	}

	const gateMsg = document.getElementById('gate-msg');
	const missing = document.getElementById('plan-missing');
	const actions = document.getElementById('plan-actions');
	const hint = document.getElementById('print-hint');
	const docEl = document.getElementById('plan-doc');

	const profile = readProfile();
	const stored = profile ? toStoredFoodOs(profile) : null;
	if (!profile || !stored || !isProfileReady(profile)) {
		if (gateMsg) gateMsg.textContent = 'Enter your stats first.';
		missing && (missing.hidden = false);
	} else {
		const result = scaleResultFromProfile(profile);
		if (!result || !docEl) {
			if (gateMsg) gateMsg.textContent = 'Enter your stats first.';
			missing && (missing.hidden = false);
		} else {
			const days = (stored.trainingDays === 4 ? 4 : 3) as TrainingDaysPref;
			const doc = buildPersonalPlan(
				{
					...stored,
					trainingDays: days,
					goalWeightKg: profile.goalWeightKg,
					targetsSource: profile.targets.source,
					dietary: profile.dietary,
				},
				result,
			);
			if (doc.nutritionAudit.length) {
				console.warn('Plan nutrition audit issues', doc.nutritionAudit);
			}
			docEl.innerHTML = renderDoc(doc);
			docEl.hidden = false;
			actions && (actions.hidden = false);
			hint && (hint.hidden = false);
			if (gateMsg) {
				const auditOk = doc.nutritionAudit.length === 0;
				gateMsg.textContent = `${doc.profile.weightKg} kg · ${doc.profile.heightCm} cm · ${GOAL_DEFAULTS[stored.goal].label} · ${ACTIVITY_LABELS[stored.activity]} · ${days}-day ${days === 4 ? 'PPLU' : 'PPL'}${auditOk ? ' · macros verified' : ' · check console for macro audit'}`;
			}
			const auto = new URLSearchParams(location.search).get('print');
			if (auto === '1') {
				requestAnimationFrame(() => window.print());
			}
		}
	}

	document.getElementById('btn-print')?.addEventListener('click', () => window.print());
</script>

<style>
	.plan-page {
		padding-top: 2rem;
		padding-bottom: 3rem;
	}
	.plan-missing {
		margin-top: 1.5rem;
		max-width: 36rem;
	}
	.print-hint {
		margin-top: 1rem;
		font-size: 0.9rem;
		max-width: 36rem;
	}
	.plan-doc {
		margin-top: 2rem;
	}
	.pd-hero {
		margin-bottom: 2rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgba(242, 242, 240, 0.14);
	}
	.pd-hero h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 4vw, 2.8rem);
		letter-spacing: 0.04em;
	}
	.pd-hero .tag {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: rgba(242, 242, 240, 0.9);
	}
	.pd-section {
		margin: 2.25rem 0;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(242, 242, 240, 0.1);
		break-inside: avoid;
	}
	.pd-section h2 {
		color: var(--yb-lime);
		margin-top: 0.25rem;
	}
	.stat-grid {
		list-style: none;
		padding: 0;
		margin: 1rem 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 0.75rem;
	}
	.stat-grid li {
		margin: 0;
		padding: 0.65rem 0 0;
		border-top: 2px solid rgba(242, 242, 240, 0.12);
	}
	.stat-grid .lab {
		display: block;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--yb-muted);
	}
	.stat-grid .val {
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.02em;
	}
	.targets {
		margin: 0.75rem 0 0;
	}
	.pd-day,
	.pd-nutri,
	.pd-block {
		margin: 1.25rem 0;
		break-inside: avoid;
	}
	.pd-day table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.92rem;
	}
	.pd-day th,
	.pd-day td {
		text-align: left;
		padding: 0.4rem 0.5rem 0.4rem 0;
		border-bottom: 1px solid rgba(242, 242, 240, 0.08);
		vertical-align: top;
	}
	.pd-day th {
		color: var(--yb-muted);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.note,
	.muted {
		color: var(--yb-muted);
	}
	.pd-day-cal {
		margin: 0.75rem 0 1rem;
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
	}
	.pd-cal-num {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		letter-spacing: 0.02em;
		color: var(--yb-offwhite);
		line-height: 1;
	}
	.pd-macro-grid {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1.1rem;
		max-width: 36rem;
	}
	@media (min-width: 520px) {
		.pd-macro-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.pd-macro-grid li {
		margin: 0;
		padding: 0.5rem 0 0;
		border-top: 2px solid rgba(242, 242, 240, 0.14);
	}
	.pd-macro-grid .val {
		display: block;
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.02em;
	}
	.pd-macro-grid .lab {
		display: block;
		margin-top: 0.1rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--yb-muted);
	}
	.pd-meals {
		display: grid;
		gap: 0;
		max-width: 40rem;
	}
	.pd-meal {
		margin: 0;
		padding: 1.15rem 0;
		border-top: 1px solid var(--yb-edge);
		break-inside: avoid;
	}
	.pd-meal-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.35rem 1rem;
	}
	.pd-meal-head h4 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-weight: 400;
		color: var(--yb-offwhite);
	}
	.pd-meal-macros {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1rem;
		font-size: 0.9rem;
	}
	.pd-meal-macros .m-lab {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--yb-steel);
	}
	.pd-ing-table,
	.pd-shop-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.88rem;
		margin-top: 0.75rem;
	}
	.pd-ing-table th,
	.pd-ing-table td,
	.pd-shop-table th,
	.pd-shop-table td {
		text-align: left;
		padding: 0.35rem 0.4rem 0.35rem 0;
		border-bottom: 1px solid rgba(242, 242, 240, 0.08);
		vertical-align: top;
	}
	.pd-ing-table th,
	.pd-shop-table th {
		color: var(--yb-muted);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.pd-ing-table td:nth-child(n + 2),
	.pd-shop-table td:nth-child(2) {
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.pd-ing-total td {
		font-weight: 700;
		border-bottom: none;
		padding-top: 0.55rem;
		color: var(--yb-offwhite);
	}
	.pd-ing-amt {
		font-family: var(--font-display);
		letter-spacing: 0.03em;
		color: var(--yb-lime);
		white-space: nowrap;
	}
	.pd-shop-table {
		max-width: 40rem;
	}
	.pd-foot {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(242, 242, 240, 0.14);
		font-size: 0.88rem;
		color: var(--yb-muted);
		max-width: 40rem;
	}

	@media print {
		:global(header.site-header),
		:global(footer.site-footer),
		:global(.skip-link),
		:global(nav),
		.plan-screen-only {
			display: none !important;
		}
		:global(body) {
			background: #0c0c0c !important;
			color: #f2f2f0 !important;
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
		.plan-page {
			padding: 0;
			max-width: none;
		}
		.plan-doc {
			margin: 0;
		}
		.pd-section {
			break-inside: avoid;
		}
	}
</style>
