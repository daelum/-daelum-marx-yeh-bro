---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact"
	description="Contact Yeh Bro about guides, disclosures, corrections, or partnership questions."
>
	<article class="prose-wrap">
		<p class="eyebrow">Contact</p>
		<h1>Get in touch</h1>
		<p class="lede">
			Corrections, disclosure questions, and partnership enquiries welcome. We do not source or sell
			illegal AAS, SARMs, peptides, or grey gear — those asks get refused. For how we talk about PED
			reality and harm reduction, see <a href="/about">About</a>.
		</p>

		<p>
			Email stub until the domain inbox is live:
			<a href="mailto:hello@yehbro.com">hello@yehbro.com</a>
		</p>

		<ul>
			<li>Content corrections → include the page URL</li>
			<li>Affiliate / disclosure → link the page in question</li>
			<li>Brand partnerships → legal sports nutrition / wellness only</li>
		</ul>

		<p><a href="/disclosure">Read disclosure</a> · <a href="/start-here">Start here</a></p>
	</article>
</BaseLayout>
