---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE_HOME } from '../consts';
---

<BaseLayout title={SITE_TITLE_HOME} description={SITE_DESCRIPTION} fullBleed>
	<section class="hero">
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="wrap hero-inner">
			<p class="eyebrow anim-rise">Australia · Bodybuilding · Harm reduction</p>
			<h1 class="anim-rise">
				<span class="brand-hero">YEH BRO</span>
			</h1>
			<p class="hero-line anim-rise-delay">{SITE_TAGLINE}</p>
			<p class="lede anim-rise-delay">
				The place AU lifters learn real PED and bodybuilding culture — risks, bloodwork, legality,
				coming off — without a gear shop attached.
			</p>
			<div class="cta-row anim-rise-delay-2">
				<a class="btn btn-primary" href="/blog/ped-harm-reduction-australia">PED education</a>
				<a class="btn btn-secondary" href="/start-here">Start here</a>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">Why Yeh Bro</p>
		<h2>Culture literacy, not a pharmacy.</h2>
		<p class="lede lane-lede">
			Gym floors and feeds mix real training craft with quietly glamorised pharmacology. We name the
			PED shadow, teach harm reduction, and monetise creatine, protein, and basics — never AAS,
			SARMs, or underground supply.
		</p>
		<ul class="principle-list">
			<li>
				<h3>PED education</h3>
				<p class="muted">
					AU legal context, health risks, bloodwork as clinical care, mental health, and coming off
					under a doctor — not cycle recipes.
				</p>
			</li>
			<li>
				<h3>Lifting craft</h3>
				<p class="muted">
					Progressive overload, food, recovery, and legal sports nutrition with label maths and AUD
					reality.
				</p>
			</li>
			<li>
				<h3>Hard fence</h3>
				<p class="muted">
					No sourcing, no UGL reviews, no “blast / PCT” affiliate funnels. Education ≠ a
					storefront.
				</p>
			</li>
		</ul>
		<div class="cta-row">
			<a class="btn btn-primary" href="/blog/ped-harm-reduction-australia">Harm reduction guide</a>
			<a class="btn btn-secondary" href="/blog/bodybuilding-culture-education">Culture explained</a>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">Education hub</p>
		<h2>Read these first</h2>
		<ul class="guide-links">
			<li>
				<a href="/blog/ped-harm-reduction-australia">
					PED harm reduction (AU)
					<span>Risks, legality, bloodwork, mental health, coming off — not a cycle guide.</span>
				</a>
			</li>
			<li>
				<a href="/blog/bodybuilding-culture-education">
					Bodybuilding culture, explained
					<span>Lifting craft, aesthetics, and the PED shadow without glamorising supply.</span>
				</a>
			</li>
			<li>
				<a href="/blog/beginner-supplement-stack-australia">
					Beginner stack (AU)
					<span>Creatine + protein + caffeine — legal nutrition order of operations.</span>
				</a>
			</li>
			<li>
				<a href="/blog/best-creatine-australia">
					Best creatine (AU)
					<span>Plain mono, 3–5 g/day, AUD trade-offs.</span>
				</a>
			</li>
			<li>
				<a href="/blog/best-protein-powder-australia">
					Best protein powder (AU)
					<span>Criteria before brands — AUD per 25 g protein.</span>
				</a>
			</li>
			<li>
				<a href="/blog/supplement-label-red-flags-australia">
					Label red flags (AU)
					<span>Proprietary blends, scoop games, skip list.</span>
				</a>
			</li>
			<li>
				<a href="/blog">
					All guides
					<span>Creatine, protein, pre, and more evidence-first reads.</span>
				</a>
			</li>
		</ul>
	</section>

	<section class="section-tight wrap email-block">
		<p class="eyebrow">Path</p>
		<h2>New here?</h2>
		<p class="lede">
			Culture + harm reduction first if PED talk is why you showed up. Legal stack literacy when you
			want tubs that stay on the right side of the law.
		</p>
		<div class="cta-row">
			<a class="btn btn-primary" href="/start-here">Get the path</a>
			<a class="btn btn-secondary" href="/about">About Yeh Bro</a>
		</div>
	</section>

	<section class="section-tight wrap">
		<p class="disclosure-strip">
			Some links are affiliate (legal sports nutrition only). Yeh Bro may earn a commission if you
			buy — no extra cost to you. We do not sell or source illegal gear.
			<a href="/disclosure">Disclosure</a>
		</p>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(92vh, 820px);
		display: flex;
		align-items: flex-end;
		padding: 6rem 0 4.5rem;
		overflow: hidden;
		border-bottom: 1px solid rgba(242, 242, 240, 0.08);
	}
	.hero-grid {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(120deg, rgba(18, 18, 18, 0.15), rgba(18, 18, 18, 0.88)),
			repeating-linear-gradient(
				90deg,
				rgba(242, 242, 240, 0.03) 0,
				rgba(242, 242, 240, 0.03) 1px,
				transparent 1px,
				transparent 72px
			),
			repeating-linear-gradient(
				0deg,
				rgba(242, 242, 240, 0.03) 0,
				rgba(242, 242, 240, 0.03) 1px,
				transparent 1px,
				transparent 72px
			),
			radial-gradient(ellipse 75% 55% at 78% 35%, rgba(200, 241, 53, 0.18), transparent 58%),
			radial-gradient(ellipse 50% 45% at 15% 70%, rgba(46, 230, 166, 0.1), transparent 55%);
		pointer-events: none;
		animation: hero-atmosphere 14s ease-in-out infinite alternate;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		padding-bottom: 1rem;
	}
	.brand-hero {
		display: inline-block;
		position: relative;
	}
	.brand-hero::after {
		content: '';
		display: block;
		height: 6px;
		width: 100%;
		margin-top: 0.35rem;
		background: var(--yb-lime);
		transform-origin: left;
		animation: underline-grow 0.8s ease 0.35s both;
	}
	.hero-line {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.9rem);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--yb-teal);
		margin: 0.75rem 0 1rem;
	}
	.lane-lede {
		max-width: 40rem;
		margin-bottom: 1.75rem;
	}
	.email-block {
		border-top: 1px solid rgba(242, 242, 240, 0.1);
		border-bottom: 1px solid rgba(242, 242, 240, 0.1);
	}
	.disclosure-strip {
		margin: 0;
		font-size: 0.95rem;
		color: var(--yb-muted);
		max-width: 40rem;
	}
	@keyframes hero-atmosphere {
		from {
			filter: brightness(1);
			transform: scale(1);
		}
		to {
			filter: brightness(1.06);
			transform: scale(1.02);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-grid {
			animation: none;
		}
	}
</style>
