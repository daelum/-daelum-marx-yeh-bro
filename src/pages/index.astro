---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { SITE_DESCRIPTION, SITE_EYEBROW, SITE_TAGLINE, SITE_TITLE, SITE_TITLE_HOME, SITE_URL } from '../consts';
import { PILLARS } from '../data/pillars';
import { FOOD_HREF, FOOD_NAME, SYSTEM_HREF, SYSTEM_NAME } from '../data/products';

const homeLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: SITE_URL,
		description: SITE_DESCRIPTION,
		inLanguage: 'en-AU',
		publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: SITE_TITLE,
		url: SITE_URL,
		description: SITE_DESCRIPTION,
		logo: new URL('/brand/yehbro-logo.png', SITE_URL).href,
	},
];

const tools = [
	{
		href: SYSTEM_HREF,
		label: SYSTEM_NAME,
		blurb: 'Five phases — foundation through recovery. Free. No signup, no card.',
	},
	{
		href: FOOD_HREF,
		label: FOOD_NAME,
		blurb: 'Calories, macros, scaled day templates, and a printable plan.',
	},
	{
		href: '/start-here/training',
		label: 'Training templates',
		blurb: '3-day PPL and 4-day PPLU with clear progression.',
	},
	{
		href: '/start-here/weekly',
		label: 'Weekly checklist',
		blurb: 'Sessions, steps, sleep, weigh-ins — tick them off in-browser.',
	},
	{
		href: '/food-bro/shopping',
		label: 'Shopping list',
		blurb: 'Weekly Woolworths list scaled to your Food Bro profile.',
	},
	{
		href: '/blog',
		label: 'Guides',
		blurb: 'Training, food, recovery, sports nutrition, culture — when you want depth.',
	},
];
---

<BaseLayout
	title={SITE_TITLE_HOME}
	description={SITE_DESCRIPTION}
	fullBleed
	canonicalPath="/"
	jsonLd={homeLd}
	ogImage="/brand/og-yehbro.jpg"
>
	<section class="hero" aria-labelledby="hero-tagline">
		<div class="hero-media" aria-hidden="true">
			<picture>
				<source srcset="/shop/yehbro-tee-back-gym.webp" type="image/webp" />
				<img
					class="hero-img"
					src="/shop/yehbro-tee-back-gym.jpg"
					alt=""
					width="1320"
					height="1382"
					decoding="async"
					fetchpriority="high"
				/>
			</picture>
			<div class="hero-shade"></div>
			<div class="hero-grit"></div>
		</div>
		<div class="wrap hero-inner">
			<p class="hero-brand anim-rise">
				<span class="sr-only">Yeh Bro</span>
				<BrandLogo size="hero" decorative />
			</p>
			<p class="hero-eyebrow anim-rise">{SITE_EYEBROW}</p>
			<h1 id="hero-tagline" class="hero-tagline anim-rise-delay">
				{SITE_TAGLINE}
			</h1>
			<p class="hero-sub anim-rise-delay">
				Fitness lifestyle for people who take training seriously — and don’t take themselves too
				seriously. Straightforward information. Useful tools. Good gear. No unnecessary bullshit.
			</p>
			<div class="cta-row anim-rise-delay-2">
				<a class="btn btn-primary" href="#pillars">Explore YehBro</a>
				<a class="btn btn-secondary" href="/shop">Shop the collection</a>
			</div>
		</div>
	</section>

	<section class="section wrap intro-block">
		<p class="eyebrow">More than just training</p>
		<h2>The whole lifestyle. One place.</h2>
		<p class="lede">
			Training is the spine. Nutrition, recovery, gym culture, and the gear you wear around it —
			that’s the rest of the world. Yeh Bro covers all of it with clear guidance and tools you’d
			actually use.
		</p>
	</section>

	<section class="section wrap" id="pillars">
		<p class="eyebrow">Your world</p>
		<h2>Under one roof.</h2>
		<p class="lede lane-lede">
			Five lanes. Pick where you are — or walk the lot. Shop is coming soon; everything else is live.
		</p>
		<ul class="pillar-grid">
			{
				PILLARS.map((pillar, i) => (
					<li style={`--i: ${i}`}>
						<a href={pillar.href} class:list={[{ 'pillar-shop': pillar.id === 'shop' }]}>
							<span class="pillar-label">{pillar.label}</span>
							<span class="pillar-line">{pillar.tagline}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section philosophy">
		<div class="wrap philosophy-inner">
			<p class="eyebrow">Philosophy</p>
			<h2>The work. The process. The results.</h2>
			<p class="lede">
				Show up. Progress the logbook. Eat for the goal. Sleep like it matters. Skip the slogans —
				beast mode, built different, no days off. Serious about the work. Light about the ego.
			</p>
			<ul class="philosophy-points">
				<li>
					<strong>Train</strong>
					<span>Simple programs you can repeat for months.</span>
				</li>
				<li>
					<strong>Fuel</strong>
					<span>Protein first, calories for the phase, powder for gaps.</span>
				</li>
				<li>
					<strong>Recover</strong>
					<span>Sleep and deloads keep the lifts moving.</span>
				</li>
			</ul>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">Less guesswork</p>
		<h2>More progress.</h2>
		<p class="lede lane-lede">
			Real tools that are live today — not a wishlist. Free. No signup, no card.
		</p>
		<ul class="guide-links">
			{
				tools.map((tool) => (
					<li>
						<a href={tool.href}>
							{tool.label}
							<span>{tool.blurb}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section brand-statement">
		<div class="wrap brand-statement-inner">
			<p class="eyebrow">The lifestyle</p>
			<h2>You don’t have to explain it.</h2>
			<p class="lede">
				If you train hard, eat big, and live like the gym is part of who you are — you’re already
				in. Yeh Bro is built for that world: clear info, useful systems, and gear on the way.
			</p>
		</div>
	</section>

	<section class="section-tight wrap final-cta">
		<p class="eyebrow">Ready?</p>
		<h2>Get into it.</h2>
		<p class="lede">
			Start with the free system and Food Bro — or browse the shop while it’s coming online.
		</p>
		<div class="cta-row">
			<a class="btn btn-primary" href={SYSTEM_HREF}>Open {SYSTEM_NAME}</a>
			<a class="btn btn-secondary" href={FOOD_HREF}>Open {FOOD_NAME}</a>
			<a class="btn btn-secondary" href="/shop">Shop</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(100svh, 920px);
		display: flex;
		align-items: flex-end;
		padding: 6rem 0 3.5rem;
		overflow: hidden;
		border-bottom: 1px solid var(--yb-edge);
	}
	.hero-media {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 58% 22%;
		display: block;
		max-width: none;
		transform: scale(1.04);
		animation: hero-scale 18s ease-in-out infinite alternate;
		filter: grayscale(0.2) contrast(1.08) brightness(0.88);
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				105deg,
				rgba(8, 8, 8, 0.96) 0%,
				rgba(8, 8, 8, 0.82) 32%,
				rgba(8, 8, 8, 0.4) 58%,
				rgba(8, 8, 8, 0.62) 100%
			),
			linear-gradient(180deg, rgba(8, 8, 8, 0.4) 0%, transparent 30%, rgba(8, 8, 8, 0.92) 100%);
	}
	.hero-grit {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 42% 38% at 20% 75%, rgba(200, 241, 53, 0.06), transparent 60%),
			var(--noise);
		opacity: 0.5;
		mix-blend-mode: overlay;
		animation: grit-pulse 20s ease-in-out infinite alternate;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: 40rem;
		padding-bottom: 0.25rem;
	}
	.hero-brand {
		margin: 0 0 1.1rem;
		line-height: 0;
	}
	.hero-brand :global(.brand-logo--hero) {
		height: clamp(6.5rem, 26vh, 12rem);
		max-width: min(100%, 14rem);
		animation: logo-settle 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.hero-eyebrow {
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--yb-lime);
		margin: 0 0 0.85rem;
	}
	.hero-tagline {
		margin: 0 0 1.1rem;
		font-size: clamp(1.65rem, 4.6vw, 2.85rem);
		line-height: 1.08;
		letter-spacing: 0.02em;
		max-width: 16ch;
		text-wrap: balance;
	}
	.hero-sub {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.55;
		color: rgba(242, 242, 240, 0.88);
		max-width: 34rem;
	}
	@keyframes logo-settle {
		from {
			transform: translateY(14px) scale(0.97);
			opacity: 0.85;
		}
		to {
			transform: translateY(0) scale(1);
			opacity: 1;
		}
	}
	.intro-block {
		padding-bottom: 2rem;
	}
	.lane-lede {
		margin-bottom: 2rem;
	}
	.pillar-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
		border-top: 1px solid var(--yb-edge);
	}
	.pillar-grid li {
		margin: 0;
		animation: rise-in 0.65s ease both;
		animation-delay: calc(var(--i) * 0.07s);
	}
	.pillar-grid a {
		display: grid;
		gap: 0.35rem;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--yb-edge);
		text-decoration: none;
		color: var(--yb-offwhite);
		transition: color 0.2s ease, padding-left 0.2s ease;
	}
	.pillar-grid a:hover {
		color: var(--yb-lime);
		padding-left: 0.4rem;
	}
	.pillar-label {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.pillar-line {
		font-size: 1rem;
		color: var(--yb-muted);
		max-width: 36rem;
	}
	.pillar-grid a.pillar-shop .pillar-label {
		color: var(--yb-lime);
	}
	.philosophy {
		border-top: 1px solid var(--yb-edge);
		border-bottom: 1px solid var(--yb-edge);
		background:
			linear-gradient(180deg, rgba(19, 19, 18, 0.65), rgba(8, 8, 8, 0.4)),
			var(--noise);
	}
	.philosophy-inner {
		max-width: 42rem;
	}
	.philosophy-points {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
	}
	@media (min-width: 720px) {
		.philosophy-points {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.75rem;
		}
	}
	.philosophy-points li {
		margin: 0;
		display: grid;
		gap: 0.35rem;
	}
	.philosophy-points strong {
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--yb-lime);
		font-weight: 400;
	}
	.philosophy-points span {
		color: rgba(242, 242, 240, 0.78);
		font-size: 0.98rem;
	}
	.brand-statement {
		position: relative;
		overflow: hidden;
	}
	.brand-statement::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 55% 70% at 90% 50%, rgba(200, 241, 53, 0.05), transparent 60%),
			var(--noise);
		pointer-events: none;
		opacity: 0.7;
	}
	.brand-statement-inner {
		position: relative;
		max-width: 40rem;
	}
	.final-cta {
		border-top: 1px solid var(--yb-edge);
		border-bottom: 1px solid var(--yb-edge);
	}
	@keyframes hero-scale {
		from {
			transform: scale(1.04);
		}
		to {
			transform: scale(1.1);
		}
	}
	@keyframes grit-pulse {
		from {
			opacity: 0.4;
		}
		to {
			opacity: 0.62;
		}
	}
	@media (max-width: 720px) {
		.hero {
			min-height: min(100svh, 860px);
			padding-top: 5rem;
		}
		.hero-img {
			object-position: 72% 18%;
		}
		.hero-shade {
			background:
				linear-gradient(
					180deg,
					rgba(8, 8, 8, 0.5) 0%,
					rgba(8, 8, 8, 0.28) 35%,
					rgba(8, 8, 8, 0.94) 78%
				),
				linear-gradient(90deg, rgba(8, 8, 8, 0.7), transparent 75%);
		}
		.hero-tagline {
			max-width: 14ch;
		}
		.hero-brand :global(.brand-logo--hero) {
			height: clamp(5.5rem, 22vh, 9.5rem);
			max-width: min(100%, 11.5rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-img,
		.hero-grit,
		.hero-brand :global(.brand-logo--hero),
		.pillar-grid li {
			animation: none;
		}
		.hero-img {
			transform: none;
		}
	}
</style>
