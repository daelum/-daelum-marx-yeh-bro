---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import FreeOffer from '../components/FreeOffer.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE, SITE_TITLE_HOME, SITE_URL } from '../consts';
import { SYSTEM_PHASES } from '../data/start-here-system';
import { FOOD_HREF, FOOD_NAME, SYSTEM_HREF, SYSTEM_NAME } from '../data/products';

const homeLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: SITE_URL,
		description: SITE_DESCRIPTION,
		inLanguage: 'en-AU',
		publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: SITE_TITLE,
		url: SITE_URL,
		description: SITE_DESCRIPTION,
		logo: new URL('/brand/yehbro-logo.png', SITE_URL).href,
	},
];
---

<BaseLayout
	title={SITE_TITLE_HOME}
	description={SITE_DESCRIPTION}
	fullBleed
	canonicalPath="/"
	jsonLd={homeLd}
	ogImage="/brand/og-yehbro.jpg"
>
	<section class="hero">
		<div class="hero-atmosphere" aria-hidden="true"></div>
		<div class="hero-scar" aria-hidden="true"></div>
		<div class="wrap hero-inner">
			<h1 class="hero-brand anim-rise">
				<span class="sr-only">Yeh Bro</span>
				<BrandLogo size="hero" decorative />
			</h1>
			<div class="anim-rise-delay">
				<FreeOffer variant="hero" />
			</div>
			<p class="hero-line anim-rise-delay">{SITE_TAGLINE}</p>
			<p class="lede anim-rise-delay">
				{SYSTEM_NAME} and {FOOD_NAME} — training that sticks, food for the cut or lean bulk, sleep
				that recovers you. Coach-grade path. Yours free.
			</p>
			<div class="cta-row anim-rise-delay-2">
				<a class="btn btn-primary" href={SYSTEM_HREF}>{SYSTEM_NAME}</a>
				<a class="btn btn-secondary" href={FOOD_HREF}>{FOOD_NAME}</a>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">The path</p>
		<h2>Five phases. One job each.</h2>
		<p class="lede lane-lede">
			Most people don’t need a new program every Monday. They need a repeatable week, progressive
			overload on a simple split, protein first, and sleep that isn’t optional. Here’s the natural
			path — then bloodwork and culture literacy when you’re ready, not day one.
		</p>
		<ol class="home-phases">
			{
				SYSTEM_PHASES.map((phase) => (
					<li>
						<a href={phase.href}>
							<span class="phase-kicker">
								{String(phase.number).padStart(2, '0')} · {phase.weeks}
							</span>
							<strong>{phase.name}</strong>
							<span class="muted"> — {phase.job}</span>
						</a>
					</li>
				))
			}
		</ol>
		<div class="cta-row">
			<a class="btn btn-primary" href="/start-here">Open Yeh Bro System</a>
			<a class="btn btn-secondary" href="/start-here/training">Training templates</a>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">Tools + depth</p>
		<h2>Use the system. Read when stuck.</h2>
		<ul class="guide-links">
			<li>
				<a href="/start-here">
					Yeh Bro System
					<span>Five phases — foundation through recovery, with tools wired in.</span>
				</a>
			</li>
			<li>
				<a href="/food-bro">
					Food Bro
					<span>Cut / maintain / lean bulk calories + macros — sticky in your browser.</span>
				</a>
			</li>
			<li>
				<a href="/start-here/training">
					Training templates
					<span>Full body 3× and Upper/Lower 4× with progression rules.</span>
				</a>
			</li>
			<li>
				<a href="/start-here/weekly">
					Weekly checklist
					<span>Sessions, steps, sleep, weigh-ins — check off in the browser.</span>
				</a>
			</li>
			<li>
				<a href="/food">
					Food hub
					<span>Protein, cutting, and lean bulk guides around the calculator.</span>
				</a>
			</li>
			<li>
				<a href="/blog/protein-targets-for-lifters">
					Protein targets
					<span>1.6–2.2 g/kg without the obsession — food first, powder for gaps.</span>
				</a>
			</li>
			<li>
				<a href="/blog/sleep-for-lifters">
					Sleep for lifters
					<span>The unpaid coach — protect a window before you add more volume.</span>
				</a>
			</li>
			<li>
				<a href="/blog/beginner-supplement-stack-australia">
					Beginner stack
					<span>Creatine + protein + caffeine — order of operations that actually matters.</span>
				</a>
			</li>
			<li>
				<a href="/blog/ped-harm-reduction-australia">
					PED culture guide
					<span>Optional later — performance-enhancing drug risks, bloodwork, legality. Not step one.</span>
				</a>
			</li>
			<li>
				<a href="/blog">
					All guides
					<span>Training, food, recovery, creatine, protein, culture — evidence-first reads.</span>
				</a>
			</li>
		</ul>
	</section>

	<section class="section-tight wrap email-block">
		<p class="eyebrow">New here?</p>
		<h2>Don’t overthink week one.</h2>
		<p class="lede">
			Open the system, book your sessions, set Food Bro, protect sleep. Depth is here when you need
			it — not when you’re still learning the bar path.
		</p>
		<div class="cta-row">
			<a class="btn btn-primary" href="/start-here">Get the system</a>
			<a class="btn btn-secondary" href="/food-bro">Set up Food Bro</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(92vh, 820px);
		display: flex;
		align-items: center;
		padding: 5.25rem 0 3.75rem;
		overflow: hidden;
		border-bottom: 1px solid var(--yb-edge);
	}
	.hero-atmosphere {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 50% 55% at 78% 38%, rgba(200, 241, 53, 0.09), transparent 58%),
			radial-gradient(ellipse 42% 48% at 12% 72%, rgba(180, 140, 70, 0.07), transparent 55%),
			radial-gradient(ellipse 70% 50% at 50% 100%, rgba(255, 255, 255, 0.035), transparent 60%),
			linear-gradient(165deg, rgba(8, 8, 8, 0.15) 0%, rgba(8, 8, 8, 0.88) 55%, #080808 100%),
			repeating-linear-gradient(
				118deg,
				transparent 0,
				transparent 3px,
				rgba(242, 242, 240, 0.018) 3px,
				rgba(242, 242, 240, 0.018) 4px
			),
			var(--noise);
		pointer-events: none;
		animation: hero-atmosphere 18s ease-in-out infinite alternate;
	}
	/* Diagonal steel scar — makes the metal mark feel grounded, not floating on flat black */
	.hero-scar {
		position: absolute;
		inset: -10% -5%;
		background:
			linear-gradient(
				105deg,
				transparent 42%,
				rgba(242, 242, 240, 0.045) 49.5%,
				rgba(200, 241, 53, 0.06) 50%,
				rgba(242, 242, 240, 0.03) 50.8%,
				transparent 58%
			);
		pointer-events: none;
		mix-blend-mode: screen;
		animation: scar-drift 22s ease-in-out infinite alternate;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		padding-bottom: 0.5rem;
		max-width: 40rem;
	}
	.hero-brand {
		margin: 0 0 1.25rem;
		line-height: 0;
	}
	.hero-brand :global(.brand-logo--hero) {
		animation: logo-settle 1.15s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.hero-line {
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3.6vw, 2.15rem);
		text-transform: uppercase;
		letter-spacing: 0.03em;
		line-height: 1.15;
		color: var(--yb-offwhite);
		margin: 0 0 0.95rem;
		max-width: 18ch;
		text-wrap: balance;
	}
	.lane-lede {
		max-width: 40rem;
		margin-bottom: 1.75rem;
	}
	.home-phases {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
		max-width: 42rem;
		display: grid;
		gap: 0.15rem;
	}
	.home-phases li {
		margin: 0;
	}
	.home-phases a {
		display: block;
		padding: 0.95rem 0;
		border-bottom: 1px solid var(--yb-edge);
		text-decoration: none;
		color: var(--yb-offwhite);
		transition: color 0.2s ease, padding-left 0.2s ease;
	}
	.home-phases a:hover {
		color: var(--yb-lime);
		padding-left: 0.35rem;
	}
	.phase-kicker {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--yb-muted);
		margin-bottom: 0.2rem;
	}
	.home-phases strong {
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-weight: 400;
	}
	.email-block {
		border-top: 1px solid var(--yb-edge);
		border-bottom: 1px solid var(--yb-edge);
	}
	@keyframes hero-atmosphere {
		from {
			filter: brightness(1) contrast(1);
			transform: scale(1);
		}
		to {
			filter: brightness(1.06) contrast(1.03);
			transform: scale(1.03);
		}
	}
	@keyframes scar-drift {
		from {
			transform: translate3d(-1.5%, 0.5%, 0) rotate(-0.4deg);
			opacity: 0.7;
		}
		to {
			transform: translate3d(1.5%, -0.8%, 0) rotate(0.5deg);
			opacity: 1;
		}
	}
	@keyframes logo-settle {
		from {
			transform: translateY(18px) scale(0.97);
			filter: contrast(1.12) brightness(0.88);
			opacity: 0.85;
		}
		to {
			transform: translateY(0) scale(1);
			filter: contrast(1) brightness(1);
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-atmosphere,
		.hero-scar,
		.hero-brand :global(.brand-logo--hero) {
			animation: none;
		}
	}
</style>
