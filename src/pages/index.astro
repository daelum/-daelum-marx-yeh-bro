---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import {
	SITE_DESCRIPTION,
	SITE_EYEBROW,
	SITE_TAGLINE,
	SITE_TITLE,
	SITE_TITLE_HOME,
	SITE_URL,
} from '../consts';
import {
	COACHING_PAID_IN_FULL_TOTAL_LABEL,
	COACHING_PAID_IN_FULL_WEEKLY_LABEL,
	COACHING_UPSELL,
	COACHING_WEEKLY_LABEL,
	PDF_CTA_LABEL,
	PDF_OFFER_PRICE_LABEL,
	PDF_PLAN_HREF,
} from '../data/pdf-offer';
import { ACTIVITY_LABELS, GOAL_DEFAULTS, type Activity, type Goal } from '../lib/food-os';

const activities = Object.entries(ACTIVITY_LABELS) as [Activity, string][];
const goals = Object.entries(GOAL_DEFAULTS) as [Goal, (typeof GOAL_DEFAULTS)[Goal]][];

const homeLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: SITE_URL,
		description: SITE_DESCRIPTION,
		inLanguage: 'en-AU',
		publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Product',
		name: 'Yeh Bro personalised training + nutrition PDF',
		description: SITE_DESCRIPTION,
		brand: { '@type': 'Brand', name: SITE_TITLE },
		offers: {
			'@type': 'Offer',
			price: '4.99',
			priceCurrency: 'AUD',
			availability: 'https://schema.org/InStock',
			url: SITE_URL,
		},
	},
];

const failReasons = [
	{
		title: 'Too much guessing',
		body: 'Changing programs every few weeks makes progress hard to track. You need a repeatable routine and a way to progress.',
	},
	{
		title: 'No nutrition plan',
		body: '“Healthy” can mean anything. A useful plan gives calorie and protein targets — and meals that make those targets practical.',
	},
	{
		title: 'Life gets in the way',
		body: 'Miss a session or have a rough weekend and the whole plan gets binned. Better habits survive ordinary weeks.',
	},
	{
		title: 'Info overload',
		body: 'Reels, conflicting advice, calculators you never finish. You know more than you execute — because nothing was built for you.',
	},
];

const pdfIncludes = [
	{
		title: 'Training plan',
		body: '3–6 day splits (PPL, PPLU, 5-day, or PPL×2) — exercises, sets, reps, and progression guidance matched to the days you can train.',
	},
	{
		title: 'Calories & macros',
		body: 'Estimated targets from your height, weight, age, sex, activity, and goal. Starting point — adjust from real-world progress.',
	},
	{
		title: 'Meal templates',
		body: 'Training-day, rest-day, and diet-break meals with food lines, quantities, kcal, and macros that add up.',
	},
	{
		title: 'Shopping list',
		body: 'Ingredients combined into a weekly list — AU supermarket-friendly weights you can use on your phone.',
	},
	{
		title: 'Clear starting point',
		body: '12-week framing, practical guidance, and a next-phase note so you’re not guessing after week four.',
	},
];

const whoFor = [
	'Fat loss or structured weight loss without turning food into punishment',
	'Building muscle and strength with a routine you can actually repeat',
	'Getting back into training after a restart cycle',
	'First-timers who want a practical plan, not jargon',
	'People who train already but need nutrition that matches their week',
	'Anyone tired of program-hopping and wanting one clear starting point',
];

const faqItems = [
	{
		q: 'Is the PDF actually personalised?',
		a: 'Yes. It’s built from the details you enter — body stats, goal, activity, and training days — not a generic template with your name stuck on top.',
	},
	{
		q: 'Is coaching required?',
		a: 'No. The $4.99 PDF is a standalone product. Coaching is optional and only offered at checkout if you want deeper accountability.',
	},
	{
		q: 'Can I use it if I’m a beginner?',
		a: 'Yes. The plan is meant to help you establish a straightforward training routine, improve nutrition habits, and build consistency. You don’t need to already “speak gym”.',
	},
	{
		q: 'Does the calorie target guarantee weight loss?',
		a: 'No calculator can guarantee an outcome. Calorie estimates are starting points. Real-world progress, recovery, hunger, and adherence should guide sensible adjustments.',
	},
	{
		q: 'What do I get after I pay?',
		a: 'Your personalised training + nutrition plan page — training, calories, macros, meals, and shopping list — ready to save as PDF or print.',
	},
];
---

<BaseLayout
	title={SITE_TITLE_HOME}
	description={SITE_DESCRIPTION}
	fullBleed
	funnel
	canonicalPath="/"
	jsonLd={homeLd}
	ogImage="/brand/og-yehbro.jpg"
>
	<section class="hero" aria-labelledby="hero-headline">
		<div class="hero-media" aria-hidden="true">
			<picture>
				<source srcset="/shop/yehbro-tee-back-gym.webp" type="image/webp" />
				<img
					class="hero-img"
					src="/shop/yehbro-tee-back-gym.jpg"
					alt=""
					width="1320"
					height="1382"
					decoding="async"
					fetchpriority="high"
				/>
			</picture>
			<div class="hero-shade"></div>
			<div class="hero-grit"></div>
		</div>
		<div class="wrap hero-inner">
			<p class="hero-brand anim-rise">
				<span class="sr-only">Yeh Bro</span>
				<BrandLogo size="hero" decorative />
			</p>
			<p class="hero-eyebrow anim-rise">{SITE_EYEBROW}</p>
			<h1 id="hero-headline" class="hero-tagline anim-rise-delay">
				Stop guessing.<br /><em>Start building.</em>
			</h1>
			<p class="hero-sub anim-rise-delay">
				A personalised training and nutrition plan built around your body, your goal, and the days
				you can actually get to the gym. No crash course. No random program. Just a plan you can
				follow — {PDF_OFFER_PRICE_LABEL} AUD.
			</p>
			<div class="cta-row anim-rise-delay-2">
				<a class="btn btn-primary" href="#intake">{PDF_CTA_LABEL}</a>
				<span class="hero-micro">One payment · Personalised PDF · No subscription</span>
			</div>
		</div>
	</section>

	<section class="section wrap" id="fail" aria-labelledby="fail-heading">
		<p class="eyebrow">The real problem</p>
		<h2 id="fail-heading">You don’t need more information. You need a plan you can stick to.</h2>
		<p class="lede">
			Most people already know they should train, eat better, and be consistent. The wheels come off
			when the plan is confusing, unrealistic — or built for someone else. You’re not necessarily
			lacking discipline. You may just lack a clear practical system.
		</p>
		<ul class="fail-grid">
			{
				failReasons.map((item, i) => (
					<li style={`--i: ${i}`}>
						<strong>{item.title}</strong>
						<span>{item.body}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section shift" id="shift" aria-labelledby="shift-heading">
		<div class="wrap shift-inner">
			<p class="eyebrow">A better start</p>
			<h2 id="shift-heading">Make the plan fit your life. Then get to work.</h2>
			<p class="lede">
				Your plan starts with your details — not a stranger’s routine from social media. Goal, body
				stats, activity, and training availability become a sensible starting point for training,
				calories, protein, meals, and shopping.
			</p>
			<p class="manifesto">
				The goal isn’t a perfect week. It’s a plan you can come back to when the week isn’t perfect.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="#intake">{PDF_CTA_LABEL}</a>
			</div>
		</div>
	</section>

	<section class="section wrap" id="who" aria-labelledby="who-heading">
		<p class="eyebrow">Who it’s for</p>
		<h2 id="who-heading">Beginners welcome. Experienced lifters still covered.</h2>
		<p class="lede">
			Not only for people who already live in the gym. If you want fat loss, muscle, strength,
			fitness, or better habits — this is a practical starting point.
		</p>
		<ul class="who-list">
			{whoFor.map((line) => <li>{line}</li>)}
		</ul>
	</section>

	<section class="section wrap" id="whats-inside" aria-labelledby="inside-heading">
		<p class="eyebrow">What you get</p>
		<h2 id="inside-heading">Everything you need to start. Nothing you don’t.</h2>
		<p class="lede">
			A practical plan designed to take the guesswork out of your next 12 weeks. Only real,
			functioning deliverables.
		</p>
		<ul class="include-list">
			{
				pdfIncludes.map((item) => (
					<li>
						<strong>{item.title}</strong>
						<span>{item.body}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section how" id="how" aria-labelledby="how-heading">
		<div class="wrap">
			<p class="eyebrow">How it works</p>
			<h2 id="how-heading">Three steps. Simple enough to actually do.</h2>
			<ol class="how-steps">
				<li>
					<strong>Tell us about you</strong>
					<span>Stats, goal, activity, and how many days you can train.</span>
				</li>
				<li>
					<strong>Your plan is built</strong>
					<span>Training, calories, macros, meal templates, and a shopping list.</span>
				</li>
				<li>
					<strong>Purchase → PDF</strong>
					<span>Pay {PDF_OFFER_PRICE_LABEL} once. Open your plan. Save as PDF / print.</span>
				</li>
			</ol>
		</div>
	</section>

	<section class="section wrap" id="intake" aria-labelledby="intake-heading">
		<p class="eyebrow">Your stats</p>
		<h2 id="intake-heading">Build it around you.</h2>
		<p class="lede">
			Saved in this browser — no account. Fill this in, then grab the plan. Example shape: 36 /
			80&nbsp;kg / 178&nbsp;cm — use your own numbers.
		</p>

		<form id="funnel-form" class="funnel-form" novalidate>
			<div class="funnel-fields">
				<label class="ff">
					<span>First name</span>
					<input
						type="text"
						name="firstName"
						id="firstName"
						autocomplete="given-name"
						required
						maxlength="40"
						placeholder="Alex"
					/>
				</label>
				<label class="ff">
					<span>Email</span>
					<input
						type="email"
						name="email"
						id="email"
						autocomplete="email"
						required
						maxlength="120"
						placeholder="you@email.com"
					/>
				</label>
				<label class="ff">
					<span>Current weight (kg)</span>
					<input
						type="number"
						name="weightKg"
						id="weightKg"
						inputmode="decimal"
						min="35"
						max="250"
						step="0.1"
						required
						placeholder="80"
					/>
				</label>
				<label class="ff">
					<span>Height (cm)</span>
					<input
						type="number"
						name="heightCm"
						id="heightCm"
						inputmode="numeric"
						min="120"
						max="230"
						step="1"
						required
						placeholder="178"
					/>
				</label>
				<label class="ff">
					<span>Age</span>
					<input
						type="number"
						name="age"
						id="age"
						inputmode="numeric"
						min="16"
						max="90"
						step="1"
						required
						placeholder="36"
					/>
				</label>
				<label class="ff">
					<span>Goal weight (kg) — optional</span>
					<input
						type="number"
						name="goalWeightKg"
						id="goalWeightKg"
						inputmode="decimal"
						min="35"
						max="250"
						step="0.1"
						placeholder="75"
					/>
				</label>
			</div>

			<fieldset class="funnel-seg" id="sex-field">
				<legend>Sex (for resting estimate)</legend>
				<label class="seg-opt">
					<input type="radio" name="sex" value="male" required checked />
					<span>Male</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="sex" value="female" />
					<span>Female</span>
				</label>
			</fieldset>

			<label class="ff ff-full">
				<span>Activity / lifestyle</span>
				<select name="activity" id="activity" required>
					{activities.map(([value, label]) => <option value={value}>{label}</option>)}
				</select>
			</label>

			<label class="ff ff-full">
				<span>Typical daily steps right now</span>
				<select name="stepsBand" id="stepsBand">
					<option value="under-5k">Under 5,000</option>
					<option value="5-8k">5,000–8,000</option>
					<option value="8-10k" selected>8,000–10,000</option>
					<option value="10k-plus">10,000+</option>
				</select>
			</label>

			<fieldset class="funnel-seg" id="goal-field">
				<legend>Goal</legend>
				{
					goals.map(([value, meta], i) => (
						<label class="seg-opt">
							<input type="radio" name="goal" value={value} required checked={i === 0} />
							<span>
								<strong>{meta.label}</strong>
								<small>{meta.blurb}</small>
							</span>
						</label>
					))
				}
			</fieldset>

			<fieldset class="funnel-seg" id="experience-field">
				<legend>Training experience</legend>
				<label class="seg-opt">
					<input type="radio" name="experience" value="beginner" checked />
					<span>
						<strong>Beginner</strong>
						<small>Under ~1 year consistent lifting</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="experience" value="intermediate" />
					<span>
						<strong>Intermediate</strong>
						<small>1–3 years</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="experience" value="experienced" />
					<span>
						<strong>Experienced</strong>
						<small>3+ years</small>
					</span>
				</label>
			</fieldset>

			<fieldset class="funnel-seg" id="equipment-field">
				<legend>Gym / equipment</legend>
				<label class="seg-opt">
					<input type="radio" name="equipment" value="full-gym" checked />
					<span>
						<strong>Full gym</strong>
						<small>Machines, cables, free weights</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="equipment" value="limited" />
					<span>
						<strong>Limited / home</strong>
						<small>Dumbbells + bodyweight</small>
					</span>
				</label>
			</fieldset>

			<fieldset class="funnel-seg" id="training-field">
				<legend>Training days / week</legend>
				<label class="seg-opt">
					<input type="radio" name="trainingDays" value="3" checked />
					<span>
						<strong>3-day PPL</strong>
						<small>Push / Pull / Legs</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="trainingDays" value="4" />
					<span>
						<strong>4-day PPLU</strong>
						<small>Add Upper</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="trainingDays" value="5" />
					<span>
						<strong>5-day</strong>
						<small>PPL + Upper + Legs B</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="trainingDays" value="6" />
					<span>
						<strong>6-day</strong>
						<small>PPL × 2</small>
					</span>
				</label>
			</fieldset>

			<label class="ff ff-full">
				<span>Typical sleep</span>
				<select name="sleepHours" id="sleepHours">
					<option value="under-6">Under 6 hours</option>
					<option value="6-7">6–7 hours</option>
					<option value="7-9" selected>7–9 hours</option>
					<option value="over-9">Over 9 hours</option>
				</select>
			</label>

			<label class="ff ff-full">
				<span>Injuries / limitations — optional</span>
				<input
					type="text"
					name="limitations"
					id="limitations"
					maxlength="200"
					placeholder="e.g. left shoulder flare-ups, bad knee"
				/>
			</label>

			<p class="funnel-preview muted" id="calc-preview" aria-live="polite">
				Enter body stats to preview calculated calories.
			</p>

			<div class="cta-row">
				<button type="submit" class="btn btn-primary" id="funnel-submit">{PDF_CTA_LABEL}</button>
			</div>
			<p class="funnel-note muted" id="funnel-note" aria-live="polite"></p>
		</form>
	</section>

	<section class="section offer" id="offer" aria-labelledby="offer-heading">
		<div class="wrap offer-inner">
			<p class="eyebrow">One-time purchase</p>
			<h2 id="offer-heading">A plan you can start today.</h2>
			<p class="lede">
				People often pay hundreds for a custom training + nutrition write-up. You’re getting
				coach-grade personalisation for {PDF_OFFER_PRICE_LABEL} AUD — honest price, no fake “was
				$X” strikethrough, no countdown timers.
			</p>
			<p class="price-line">
				<span class="price">{PDF_OFFER_PRICE_LABEL}</span>
				<span class="price-meta">AUD · one-time · personalised PDF</span>
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="#checkout" id="offer-cta">{PDF_CTA_LABEL}</a>
			</div>
		</div>
	</section>

	<section class="section wrap checkout-panel" id="checkout" aria-labelledby="checkout-heading" hidden>
		<p class="eyebrow">Checkout</p>
		<h2 id="checkout-heading">Confirm &amp; pay</h2>
		<p class="lede" id="checkout-summary">
			Personalised PDF — {PDF_OFFER_PRICE_LABEL} AUD. Optional coaching add-on below if you want
			deeper accountability.
		</p>

		<div class="checkout-card" id="checkout-pdf-line">
			<strong>Personalised training + nutrition PDF</strong>
			<span class="checkout-price">{PDF_OFFER_PRICE_LABEL} AUD</span>
		</div>

		<details class="upsell" id="coaching-upsell">
			<summary>
				<span class="upsell-title">Optional add-on: {COACHING_UPSELL.name}</span>
				<span class="upsell-hint">Deeper than the PDF · not required</span>
			</summary>
			<p class="upsell-blurb">{COACHING_UPSELL.blurb}</p>
			<fieldset class="funnel-seg upsell-tiers" id="coaching-field">
				<legend class="sr-only">Coaching add-on</legend>
				<label class="seg-opt">
					<input type="radio" name="coaching" value="none" checked />
					<span>
						<strong>PDF only</strong>
						<small>No coaching add-on</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="coaching" value="weekly" />
					<span>
						<strong>Weekly coaching — {COACHING_WEEKLY_LABEL}</strong>
						<small>Personalised accountability, billed weekly</small>
					</span>
				</label>
				<label class="seg-opt">
					<input type="radio" name="coaching" value="paid_in_full" />
					<span>
						<strong>
							12 weeks paid in full — {COACHING_PAID_IN_FULL_WEEKLY_LABEL} ({COACHING_PAID_IN_FULL_TOTAL_LABEL}{' '}
							total)
						</strong>
						<small>
							{COACHING_UPSELL.weeks}-week block · {COACHING_PAID_IN_FULL_WEEKLY_LABEL} when paid
							upfront
						</small>
					</span>
				</label>
			</fieldset>
		</details>

		<div class="cta-row">
			<button type="button" class="btn btn-primary" id="pay-btn">{PDF_CTA_LABEL}</button>
		</div>
		<p class="funnel-note muted" id="checkout-note" aria-live="polite"></p>
	</section>

	<section class="section wrap" id="coaching-note" aria-labelledby="coaching-note-heading">
		<p class="eyebrow">Optional support</p>
		<h2 id="coaching-note-heading">Some people need a plan. Others need someone in their corner.</h2>
		<p class="lede">
			The PDF is yours to run independently. If you want deeper accountability, check-ins, and
			adjustments, coaching is offered as an optional add-on at checkout — not a requirement.
			Weekly {COACHING_WEEKLY_LABEL}, or {COACHING_PAID_IN_FULL_TOTAL_LABEL} paid upfront (
			{COACHING_PAID_IN_FULL_WEEKLY_LABEL} × {COACHING_UPSELL.weeks}).
		</p>
	</section>

	<section class="section-tight wrap" id="reassure" aria-labelledby="reassure-heading">
		<p class="eyebrow">Straight talk</p>
		<h2 id="reassure-heading">Education, not medical advice.</h2>
		<p class="lede">
			Calorie and training estimates are a starting point. Adjust from how you feel, how training
			goes, and your scale trend. Under 18 or clinical conditions — talk to a clinician. The PDF
			stands alone; coaching is optional at checkout only.
		</p>
	</section>

	<section class="section wrap faq" id="faq" aria-labelledby="faq-heading">
		<p class="eyebrow">Straight answers</p>
		<h2 id="faq-heading">Before you start.</h2>
		<div class="faq-list">
			{
				faqItems.map((item) => (
					<details>
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="section-tight wrap final-cta" id="final" aria-labelledby="final-heading">
		<p class="eyebrow">Ready?</p>
		<h2 id="final-heading">Don’t wait for another Monday.</h2>
		<p class="lede">
			Enter your stats, pay {PDF_OFFER_PRICE_LABEL}, open the PDF. Same Yeh Bro metal. Built for you.
		</p>
		<div class="cta-row">
			<a class="btn btn-primary" href="#intake">{PDF_CTA_LABEL}</a>
		</div>
	</section>

	<div class="sticky-cta" id="sticky-cta" hidden>
		<span class="sticky-copy">Personalised plan · <strong>{PDF_OFFER_PRICE_LABEL} AUD</strong></span>
		<a class="btn btn-primary" href="#intake">{PDF_CTA_LABEL}</a>
	</div>
</BaseLayout>

<script>
	import {
		PDF_CTA_LABEL,
		PDF_OFFER_PRICE_LABEL,
		PDF_PLAN_HREF,
		PDF_UNLOCK_STORAGE_KEY,
	} from '../data/pdf-offer';
	import {
		GOAL_DEFAULTS,
		type Activity,
		type Goal,
		type Sex,
		type TrainingDaysPref,
	} from '../lib/food-os';
	import {
		EXAMPLE_PROFILE_HINT,
		calcFromProfile,
		isPlanIntakeReady,
		isProfileReady,
		readProfile,
		writeProfile,
		type YehBroProfile,
	} from '../lib/user-store';

	const form = document.getElementById('funnel-form') as HTMLFormElement | null;
	const calcPreview = document.getElementById('calc-preview');
	const funnelNote = document.getElementById('funnel-note');
	const checkoutPanel = document.getElementById('checkout');
	const checkoutNote = document.getElementById('checkout-note');
	const payBtn = document.getElementById('pay-btn') as HTMLButtonElement | null;
	const activitySelect = document.getElementById('activity') as HTMLSelectElement | null;

	type CoachingTier = 'none' | 'weekly' | 'paid_in_full';

	function selectedRadio(name: string): string | null {
		const el = form?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
		return el?.value ?? null;
	}

	function coachingChoice(): CoachingTier {
		const el = document.querySelector<HTMLInputElement>('input[name="coaching"]:checked');
		const v = el?.value;
		if (v === 'weekly' || v === 'paid_in_full') return v;
		return 'none';
	}

	function num(name: string): number | undefined {
		const el = form?.elements.namedItem(name) as HTMLInputElement | null;
		if (!el?.value) return undefined;
		const n = Number(el.value);
		return Number.isFinite(n) ? n : undefined;
	}

	function text(name: string): string | undefined {
		const el = form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
		const v = el?.value?.trim();
		return v || undefined;
	}

	function collectPartial(): Partial<YehBroProfile> {
		const sex = selectedRadio('sex') as Sex | null;
		const goal = selectedRadio('goal') as Goal | null;
		const trainingRaw = selectedRadio('trainingDays');
		const trainingParsed = Number(trainingRaw);
		const trainingDays = ([3, 4, 5, 6].includes(trainingParsed)
			? trainingParsed
			: 3) as TrainingDaysPref;
		const activity = (activitySelect?.value || undefined) as Activity | undefined;
		const experience = selectedRadio('experience') as YehBroProfile['experience'];
		const equipment = selectedRadio('equipment') as YehBroProfile['equipment'];
		const stepsBand = text('stepsBand') as YehBroProfile['stepsBand'];
		const sleepHours = text('sleepHours') as YehBroProfile['sleepHours'];
		const cutPct = goal === 'cut' ? Math.round(Math.abs(GOAL_DEFAULTS.cut.defaultAdj) * 100) : 18;
		const bulkPct =
			goal === 'lean-bulk' ? Math.round(Math.abs(GOAL_DEFAULTS['lean-bulk'].defaultAdj) * 100) : 10;

		return {
			firstName: text('firstName'),
			email: text('email'),
			weightKg: num('weightKg'),
			heightCm: num('heightCm'),
			age: num('age'),
			goalWeightKg: num('goalWeightKg'),
			sex: sex ?? undefined,
			goal: goal ?? undefined,
			activity,
			trainingDays,
			experience: experience ?? undefined,
			equipment: equipment ?? undefined,
			stepsBand,
			sleepHours,
			limitations: text('limitations'),
			cutPct,
			bulkPct,
			targets: { source: 'calculated' },
		};
	}

	function syncPreview() {
		if (!calcPreview) return;
		const partial = collectPartial();
		const base = readProfile();
		const draft: YehBroProfile = {
			version: 1,
			updatedAt: new Date().toISOString(),
			cutPct: partial.cutPct ?? base?.cutPct ?? 18,
			bulkPct: partial.bulkPct ?? base?.bulkPct ?? 10,
			trainingDays: (partial.trainingDays ?? base?.trainingDays ?? 3) as TrainingDaysPref,
			targets: partial.targets ?? base?.targets ?? { source: 'calculated' },
			dietary: base?.dietary ?? { pattern: 'none', excludes: '', notes: '' },
			weightKg: partial.weightKg ?? base?.weightKg,
			heightCm: partial.heightCm ?? base?.heightCm,
			age: partial.age ?? base?.age,
			goalWeightKg: partial.goalWeightKg ?? base?.goalWeightKg,
			sex: partial.sex ?? base?.sex,
			activity: partial.activity ?? base?.activity,
			goal: partial.goal ?? base?.goal,
		};
		if (!isProfileReady(draft)) {
			calcPreview.textContent = 'Enter body stats to preview calculated calories.';
			return;
		}
		const result = calcFromProfile(draft);
		if (!result || !draft.goal) {
			calcPreview.textContent = 'Enter body stats to preview calculated calories.';
			return;
		}
		const label = GOAL_DEFAULTS[draft.goal].label;
		calcPreview.textContent = `Preview: ~${result.calories} kcal · P ${result.proteinG}g / C ${result.carbsG}g / F ${result.fatG}g · ${label}`;
	}

	function hydrate() {
		const p = readProfile();
		if (!form) return;
		const firstName = document.getElementById('firstName') as HTMLInputElement | null;
		const email = document.getElementById('email') as HTMLInputElement | null;
		const weight = document.getElementById('weightKg') as HTMLInputElement | null;
		const height = document.getElementById('heightCm') as HTMLInputElement | null;
		const age = document.getElementById('age') as HTMLInputElement | null;
		const goalW = document.getElementById('goalWeightKg') as HTMLInputElement | null;
		const stepsBand = document.getElementById('stepsBand') as HTMLSelectElement | null;
		const sleepHours = document.getElementById('sleepHours') as HTMLSelectElement | null;
		const limitations = document.getElementById('limitations') as HTMLInputElement | null;
		if (weight) weight.placeholder = String(EXAMPLE_PROFILE_HINT.weightKg);
		if (height) height.placeholder = String(EXAMPLE_PROFILE_HINT.heightCm);
		if (age) age.placeholder = String(EXAMPLE_PROFILE_HINT.age);
		if (goalW) goalW.placeholder = String(EXAMPLE_PROFILE_HINT.goalWeightKg);
		if (!p) {
			if (activitySelect) activitySelect.value = 'moderate';
			syncPreview();
			return;
		}
		if (firstName && p.firstName) firstName.value = p.firstName;
		if (email && p.email) email.value = p.email;
		if (weight && p.weightKg != null) weight.value = String(p.weightKg);
		if (height && p.heightCm != null) height.value = String(p.heightCm);
		if (age && p.age != null) age.value = String(p.age);
		if (goalW && p.goalWeightKg != null) goalW.value = String(p.goalWeightKg);
		if (p.sex) {
			const sexEl = form.querySelector<HTMLInputElement>(`input[name="sex"][value="${p.sex}"]`);
			if (sexEl) sexEl.checked = true;
		}
		if (p.goal) {
			const goalEl = form.querySelector<HTMLInputElement>(`input[name="goal"][value="${p.goal}"]`);
			if (goalEl) goalEl.checked = true;
		}
		if (p.experience) {
			const exp = form.querySelector<HTMLInputElement>(
				`input[name="experience"][value="${p.experience}"]`,
			);
			if (exp) exp.checked = true;
		}
		if (p.equipment) {
			const eq = form.querySelector<HTMLInputElement>(
				`input[name="equipment"][value="${p.equipment}"]`,
			);
			if (eq) eq.checked = true;
		}
		if (p.trainingDays) {
			const td = form.querySelector<HTMLInputElement>(
				`input[name="trainingDays"][value="${p.trainingDays}"]`,
			);
			if (td) td.checked = true;
		}
		if (activitySelect && p.activity) activitySelect.value = p.activity;
		if (stepsBand && p.stepsBand) stepsBand.value = p.stepsBand;
		if (sleepHours && p.sleepHours) sleepHours.value = p.sleepHours;
		if (limitations && p.limitations) limitations.value = p.limitations;
		syncPreview();
	}

	function showCheckout() {
		if (!checkoutPanel) return;
		checkoutPanel.hidden = false;
		checkoutPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}

	function unlockLocal(
		coaching: CoachingTier,
		mode: 'stub' | 'stripe' | 'local-preview',
		sessionId?: string,
	) {
		localStorage.setItem(
			PDF_UNLOCK_STORAGE_KEY,
			JSON.stringify({
				at: new Date().toISOString(),
				priceAud: 4.99,
				coaching,
				mode,
				sessionId: sessionId || undefined,
				verified: mode === 'stripe' || mode === 'stub' || mode === 'local-preview',
			}),
		);
	}

	async function runCheckout() {
		if (!checkoutNote || !payBtn) return;
		const profile = readProfile();
		if (!isPlanIntakeReady(profile)) {
			checkoutNote.textContent = 'Finish your name, email, and stats above first.';
			form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			return;
		}

		const coaching = coachingChoice();
		payBtn.disabled = true;
		payBtn.textContent = 'Working…';
		checkoutNote.textContent = '';

		try {
			const res = await fetch('/api/checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					coaching,
					successUrl: `${location.origin}${PDF_PLAN_HREF}?checkout=success`,
					cancelUrl: `${location.origin}/#checkout`,
				}),
			});
			const data = (await res.json()) as {
				mode?: string;
				ok?: boolean;
				url?: string;
				message?: string;
				requiredSecrets?: string[];
			};

			if (data.mode === 'stripe' && data.url) {
				// Do NOT unlock before payment — /plan verifies session_id server-side.
				location.href = data.url;
				return;
			}

			if (data.mode === 'stub') {
				unlockLocal(coaching, 'stub');
				checkoutNote.textContent =
					data.message ||
					`Live Stripe secrets not bound yet — stub unlock for preview. Required for live charges: ${(data.requiredSecrets || []).join(', ')}.`;
				payBtn.textContent = PDF_CTA_LABEL;
				payBtn.disabled = false;
				window.setTimeout(() => {
					location.href = `${PDF_PLAN_HREF}?checkout=stub`;
				}, 900);
				return;
			}

			checkoutNote.textContent = data.message || 'Checkout failed. Try again.';
			payBtn.disabled = false;
			payBtn.textContent = PDF_CTA_LABEL;
		} catch {
			// Dev / static preview without Functions — stub unlock clearly marked.
			unlockLocal(coaching, 'local-preview');
			checkoutNote.textContent = `Checkout API unavailable in this preview — local stub unlock only. Bind Stripe secrets for live charges.`;
			payBtn.disabled = false;
			payBtn.textContent = PDF_CTA_LABEL;
			window.setTimeout(() => {
				location.href = `${PDF_PLAN_HREF}?checkout=local`;
			}, 900);
		}
	}

	form?.addEventListener('input', syncPreview);
	form?.addEventListener('change', syncPreview);

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			if (funnelNote) funnelNote.textContent = 'Fill the required fields first.';
			return;
		}
		const next = writeProfile(collectPartial());
		if (!isPlanIntakeReady(next)) {
			if (funnelNote)
				funnelNote.textContent =
					'Something’s missing — check first name, email, weight, height, age, sex, activity, and goal.';
			return;
		}
		if (funnelNote) {
			funnelNote.textContent = `Stats saved. ${PDF_OFFER_PRICE_LABEL} unlocks your personalised PDF.`;
		}
		showCheckout();
	});

	document.getElementById('offer-cta')?.addEventListener('click', (e) => {
		const profile = readProfile();
		if (!isPlanIntakeReady(profile)) {
			e.preventDefault();
			form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			if (funnelNote) funnelNote.textContent = 'Enter your name, email, and stats first — then checkout.';
			return;
		}
		showCheckout();
	});

	payBtn?.addEventListener('click', () => {
		void runCheckout();
	});

	hydrate();

	if (location.hash === '#checkout' && isPlanIntakeReady(readProfile())) {
		showCheckout();
	}

	const sticky = document.getElementById('sticky-cta');
	const intake = document.getElementById('intake');
	const heroEl = document.querySelector('.hero');
	function syncSticky() {
		if (!sticky || !intake || !heroEl) return;
		const pastHero = window.scrollY > heroEl.getBoundingClientRect().height * 0.65;
		const intakeRect = intake.getBoundingClientRect();
		const intakeInView = intakeRect.top < window.innerHeight * 0.75 && intakeRect.bottom > 80;
		sticky.hidden = !pastHero || intakeInView;
	}
	sticky && (sticky.hidden = true);
	window.addEventListener('scroll', syncSticky, { passive: true });
	window.addEventListener('resize', syncSticky, { passive: true });
</script>

