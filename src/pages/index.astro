---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE_HOME } from '../consts';

const lanes = [
	{
		href: '/start-here#step-2',
		label: 'Training',
		blurb: 'Consistency + progressive overload.',
		image: '/images/cover-training.jpg',
	},
	{
		href: '/start-here#step-3',
		label: 'Food',
		blurb: 'Protein first; phases when ready.',
		image: '/images/cover-food.jpg',
	},
	{
		href: '/start-here#step-4',
		label: 'Recovery',
		blurb: 'Sleep is part of the program.',
		image: '/images/cover-recovery.jpg',
	},
	{
		href: '/start-here#step-5',
		label: 'Supplements',
		blurb: 'Creatine, protein convenience, caffeine.',
		image: '/images/cover-supplements.jpg',
	},
	{
		href: '/blog/bodybuilding-culture-education',
		label: 'Culture',
		blurb: 'Optional PED literacy — not day one.',
		image: '/images/cover-culture.jpg',
	},
];
---

<BaseLayout
	title={SITE_TITLE_HOME}
	description={SITE_DESCRIPTION}
	fullBleed
	image="/images/og-default.jpg"
>
	<section class="hero">
		<div class="hero-media" aria-hidden="true">
			<img src="/images/hero-gym.jpg" alt="" width="1280" height="720" fetchpriority="high" />
		</div>
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="wrap hero-inner">
			<p class="eyebrow anim-rise">Training · Food · Recovery</p>
			<h1 class="anim-rise">
				<span class="brand-hero">YEH BRO</span>
			</h1>
			<p class="hero-line anim-rise-delay">{SITE_TAGLINE}</p>
			<p class="lede anim-rise-delay">
				A clear path for getting into the best shape of your life — training that sticks, food that
				makes sense, sleep that actually recovers you. Start with the blueprint.
			</p>
			<div class="cta-row anim-rise-delay-2">
				<a class="btn btn-primary" href="/start-here">Start here</a>
				<a class="btn btn-secondary" href="/blog/bodybuilding-blueprint">Phases later</a>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">The path</p>
		<h2>Six steps. No circus.</h2>
		<p class="lede lane-lede">
			Most people don’t need a new program every Monday. They need honesty about where they are,
			a simple lift plan, enough protein, and sleep that isn’t optional. Here’s how I’d walk someone
			through it.
		</p>
		<ol class="home-steps">
			<li>
				<strong>Mindset</strong>
				<span class="muted"> — where you’re starting, without cosplay timelines</span>
			</li>
			<li>
				<strong>Training</strong>
				<span class="muted"> — consistency + progressive overload on a simple split</span>
			</li>
			<li>
				<strong>Food</strong>
				<span class="muted"> — protein first; deficit or surplus when you’re ready</span>
			</li>
			<li>
				<strong>Sleep / recovery</strong>
				<span class="muted"> — the boring lever that pays the most</span>
			</li>
			<li>
				<strong>Supplements that matter</strong>
				<span class="muted"> — creatine, protein powder if food is awkward</span>
			</li>
			<li>
				<strong>Optional deeper</strong>
				<span class="muted"> — culture / PED literacy when you’re ready, not day one</span>
			</li>
		</ol>
		<div class="cta-row">
			<a class="btn btn-primary" href="/start-here">Open the full blueprint</a>
			<a class="btn btn-secondary" href="/about">About Yeh Bro</a>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">Lanes</p>
		<h2>Pick a surface.</h2>
		<p class="lede lane-lede">
			Same path, different entry. Jump into a lane when you already know what you need.
		</p>
		<ul class="lane-list">
			{
				lanes.map((lane) => (
					<li>
						<a href={lane.href} class="lane-link">
							<span class="lane-img" aria-hidden="true">
								<img src={lane.image} alt="" width="640" height="360" loading="lazy" />
							</span>
							<span class="lane-copy">
								<span class="lane-label">{lane.label}</span>
								<span class="lane-blurb">{lane.blurb}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section wrap">
		<p class="eyebrow">Guides when you need them</p>
		<h2>Read after you start</h2>
		<ul class="guide-links">
			<li>
				<a href="/start-here">
					Start here
					<span>Numbered journey — mindset through supplements, then optional deeper reads.</span>
				</a>
			</li>
			<li>
				<a href="/blog/beginner-supplement-stack-australia">
					Beginner stack
					<span>Creatine + protein + caffeine — order of operations that actually matters.</span>
				</a>
			</li>
			<li>
				<a href="/blog/best-creatine-australia">
					Creatine buy guide
					<span>Plain mono, 3–5 g/day, cost-per-serve without the form theatre.</span>
				</a>
			</li>
			<li>
				<a href="/blog/best-protein-powder-australia">
					Protein powder guide
					<span>Criteria before brands — cost per 25 g protein.</span>
				</a>
			</li>
			<li>
				<a href="/blog/bodybuilding-blueprint">
					Bodybuilding blueprint
					<span>Cut → health pivot → lean bulk once the basics are locked.</span>
				</a>
			</li>
			<li>
				<a href="/blog/ped-harm-reduction-australia">
					PED culture guide
					<span>Optional later — risks, bloodwork, legality. Not step one.</span>
				</a>
			</li>
			<li>
				<a href="/blog">
					All guides
					<span>Creatine, protein, pre, culture — evidence-first reads.</span>
				</a>
			</li>
		</ul>
	</section>

	<section class="section-tight wrap email-block">
		<p class="eyebrow">New here?</p>
		<h2>Don’t overthink the first week.</h2>
		<p class="lede">
			Show up, lift with a plan, eat enough protein, sleep. The rest of the site is there when you
			want depth — not when you’re still learning the bar path.
		</p>
		<div class="cta-row">
			<a class="btn btn-primary" href="/start-here">Get the path</a>
			<a class="btn btn-secondary" href="/blog">Browse guides</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(92vh, 820px);
		display: flex;
		align-items: flex-end;
		padding: 6rem 0 4.5rem;
		overflow: hidden;
		border-bottom: 1px solid rgba(242, 242, 240, 0.08);
	}
	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% center;
		display: block;
		transform: scale(1.02);
		animation: hero-atmosphere 14s ease-in-out infinite alternate;
	}
	.hero-grid {
		position: absolute;
		inset: 0;
		z-index: 0;
		background:
			linear-gradient(120deg, rgba(18, 18, 18, 0.55), rgba(18, 18, 18, 0.92)),
			repeating-linear-gradient(
				90deg,
				rgba(242, 242, 240, 0.03) 0,
				rgba(242, 242, 240, 0.03) 1px,
				transparent 1px,
				transparent 72px
			),
			repeating-linear-gradient(
				0deg,
				rgba(242, 242, 240, 0.03) 0,
				rgba(242, 242, 240, 0.03) 1px,
				transparent 1px,
				transparent 72px
			),
			radial-gradient(ellipse 75% 55% at 78% 35%, rgba(200, 241, 53, 0.12), transparent 58%),
			radial-gradient(ellipse 50% 45% at 15% 70%, rgba(46, 230, 166, 0.08), transparent 55%);
		pointer-events: none;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		padding-bottom: 1rem;
	}
	.brand-hero {
		display: inline-block;
		position: relative;
	}
	.brand-hero::after {
		content: '';
		display: block;
		height: 6px;
		width: 100%;
		margin-top: 0.35rem;
		background: var(--yb-lime);
		transform-origin: left;
		animation: underline-grow 0.8s ease 0.35s both;
	}
	.hero-line {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.9rem);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--yb-teal);
		margin: 0.75rem 0 1rem;
	}
	.lane-lede {
		max-width: 40rem;
		margin-bottom: 1.75rem;
	}
	.home-steps {
		margin: 0 0 2rem;
		padding-left: 1.35rem;
		max-width: 40rem;
		display: grid;
		gap: 0.85rem;
		font-size: 1.05rem;
		line-height: 1.45;
	}
	.home-steps li strong {
		color: var(--yb-offwhite);
	}
	.email-block {
		border-top: 1px solid rgba(242, 242, 240, 0.1);
		border-bottom: 1px solid rgba(242, 242, 240, 0.1);
	}
	.lane-list {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		display: grid;
		gap: 0;
	}
	.lane-link {
		display: grid;
		grid-template-columns: minmax(7rem, 11rem) 1fr;
		gap: 1rem;
		align-items: center;
		padding: 0.85rem 0;
		border-bottom: 1px solid rgba(242, 242, 240, 0.12);
		text-decoration: none;
		color: var(--yb-offwhite);
		transition: color 0.2s ease;
	}
	.lane-link:hover {
		color: var(--yb-lime);
	}
	.lane-img {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 9;
	}
	.lane-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.45s ease;
	}
	.lane-link:hover .lane-img img {
		transform: scale(1.04);
	}
	.lane-label {
		display: block;
		font-family: var(--font-display);
		font-size: 1.35rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.lane-blurb {
		display: block;
		font-size: 0.95rem;
		color: var(--yb-muted);
		margin-top: 0.2rem;
	}
	@keyframes hero-atmosphere {
		from {
			filter: brightness(1);
			transform: scale(1.02);
		}
		to {
			filter: brightness(1.06);
			transform: scale(1.05);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-media img,
		.lane-link:hover .lane-img img {
			animation: none;
			transform: none;
		}
	}
</style>
