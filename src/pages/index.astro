---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE_HOME } from '../consts';
---

<BaseLayout title={SITE_TITLE_HOME} description={SITE_DESCRIPTION} fullBleed>
	<section class="hero">
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="wrap hero-inner">
			<p class="eyebrow anim-rise">Australia · Faceless · Natural lifter</p>
			<h1 class="anim-rise">
				<span class="brand-hero">YEH BRO</span>
			</h1>
			<p class="hero-line anim-rise-delay">{SITE_TAGLINE}</p>
			<p class="lede anim-rise-delay">
				AU-practical guides on creatine, protein, and pre — label maths, dosing ranges, and
				honest trade-offs. No grey chemistry. No overnight-gain nonsense.
			</p>
			<div class="cta-row anim-rise-delay-2">
				<a class="btn btn-primary" href="/start-here">Start here</a>
				<a class="btn btn-secondary" href="/blog/best-creatine-australia">Best creatine (AU)</a>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<p class="eyebrow">How we pick</p>
		<h2>Three rules. That’s it.</h2>
		<ul class="principle-list">
			<li>
				<h3>Evidence</h3>
				<p class="muted">
					Consensus dosing and label facts first. Soft claims stay soft. Therapeutic promises don’t
					make the cut.
				</p>
			</li>
			<li>
				<h3>AU reality</h3>
				<p class="muted">
					AUD pricing, local stockists, and shipping honesty. If it’s US-only, we say so.
				</p>
			</li>
			<li>
				<h3>No grey chemistry</h3>
				<p class="muted">
					Legal sports nutrition only. No AAS, SARMs, unapproved peptides, or cycle funnels — ever.
				</p>
			</li>
		</ul>
	</section>

	<section class="section wrap">
		<p class="eyebrow">Top guides</p>
		<h2>Read these first</h2>
		<ul class="guide-links">
			<li>
				<a href="/blog/beginner-supplement-stack-australia">
					Beginner stack (AU)
					<span>Creatine + protein + caffeine — order of operations.</span>
				</a>
			</li>
			<li>
				<a href="/blog/best-creatine-australia">
					Creatine monohydrate (AU)
					<span>3–5 g/day, scoop maths, what to buy.</span>
				</a>
			</li>
			<li>
				<a href="/blog/creapure-vs-generic-creatine">
					Creapure vs generic creatine
					<span>When the named supply chain is worth the AUD gap.</span>
				</a>
			</li>
			<li>
				<a href="/blog/best-protein-powder-australia">
					Best protein powder (AU)
					<span>Criteria before brands — AUD per 25 g protein.</span>
				</a>
			</li>
			<li>
				<a href="/blog/protein-per-scoop-australia">
					Protein per scoop
					<span>Panel maths and label red flags AU buyers miss.</span>
				</a>
			</li>
			<li>
				<a href="/blog/proprietary-blend-pre-workout">
					Proprietary blend pre-workouts
					<span>Why we skip most of them — dose guessing.</span>
				</a>
			</li>
			<li>
				<a href="/blog">
					All guides
					<span>Cheapest protein, stim-free, mono vs HCL, and more.</span>
				</a>
			</li>
		</ul>
	</section>

	<section class="section-tight wrap email-block">
		<p class="eyebrow">Lead magnet</p>
		<h2>AU beginner stack checklist</h2>
		<p class="lede">
			Creatine + protein + caffeine basics in one short checklist. Email signup lands when Beehiiv is
			wired — for now, use Start here.
		</p>
		<div class="cta-row">
			<a class="btn btn-primary" href="/start-here">Get the path</a>
			<a class="btn btn-secondary" href="/contact">Contact</a>
		</div>
	</section>

	<section class="section-tight wrap">
		<p class="disclosure-strip">
			Some links are affiliate. Yeh Bro may earn a commission if you buy — no extra cost to you.
			<a href="/disclosure">Disclosure</a>
		</p>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(92vh, 820px);
		display: flex;
		align-items: flex-end;
		padding: 6rem 0 4.5rem;
		overflow: hidden;
		border-bottom: 1px solid rgba(242, 242, 240, 0.08);
	}
	.hero-grid {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(120deg, rgba(18, 18, 18, 0.2), rgba(18, 18, 18, 0.85)),
			repeating-linear-gradient(
				90deg,
				rgba(242, 242, 240, 0.03) 0,
				rgba(242, 242, 240, 0.03) 1px,
				transparent 1px,
				transparent 72px
			),
			repeating-linear-gradient(
				0deg,
				rgba(242, 242, 240, 0.03) 0,
				rgba(242, 242, 240, 0.03) 1px,
				transparent 1px,
				transparent 72px
			),
			radial-gradient(ellipse 70% 60% at 70% 40%, rgba(200, 241, 53, 0.16), transparent 60%);
		pointer-events: none;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		padding-bottom: 1rem;
	}
	.brand-hero {
		display: inline-block;
		position: relative;
	}
	.brand-hero::after {
		content: '';
		display: block;
		height: 6px;
		width: 100%;
		margin-top: 0.35rem;
		background: var(--yb-lime);
		transform-origin: left;
		animation: underline-grow 0.8s ease 0.35s both;
	}
	.hero-line {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.9rem);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--yb-teal);
		margin: 0.75rem 0 1rem;
	}
	.email-block {
		border-top: 1px solid rgba(242, 242, 240, 0.1);
		border-bottom: 1px solid rgba(242, 242, 240, 0.1);
	}
	.disclosure-strip {
		margin: 0;
		font-size: 0.95rem;
		color: var(--yb-muted);
		max-width: 40rem;
	}
</style>
