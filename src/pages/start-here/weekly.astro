---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPath from '../../components/ProductPath.astro';
import { WEEKLY_CHECKLIST } from '../../data/start-here-system';
---

<BaseLayout
	title="Weekly checklist — Yeh Bro System"
	description="Interactive weekly checklist for training, steps, sleep, and weigh-ins — part of Yeh Bro’s Yeh Bro System. Saves in your browser."
	canonicalPath="/start-here/weekly"
>
	<ProductPath
		crumbs={[
			{ href: '/train', label: 'Train' },
			{ href: '/start-here', label: 'Yeh Bro System' },
			{ href: '/start-here/training', label: 'Training' },
			{ href: '/start-here/weekly', label: 'Weekly', current: true },
		]}
	/>

	<article class="wrap week-page">
		<p class="eyebrow anim-rise">Train · Recover</p>
		<h1 class="anim-rise">Weekly checklist</h1>
		<p class="lede anim-rise-delay">
			Tick what you did. State saves in this browser (localStorage) so returning feels sticky — not
			another PDF you ignore. Training days sync with your Yeh Bro profile. Reset when you start a new
			week.
		</p>
		<p class="week-profile-link muted" id="week-profile-link"></p>
		<div class="week-toolbar anim-rise-delay-2">
			<p class="week-status" id="week-status" aria-live="polite">Loading…</p>
			<button type="button" class="btn btn-secondary" id="week-reset">Reset this week</button>
		</div>

		<fieldset class="split-picker" id="split-picker">
			<legend class="split-legend">Training days this week</legend>
			<div class="split-options" role="radiogroup" aria-label="Training days this week">
				<label class="split-option">
					<input type="radio" name="days-per-week" value="3" data-split="ppl" checked />
					<span>
						<strong>3-day PPL</strong>
						<span class="split-hint">Push · Pull · Legs</span>
					</span>
				</label>
				<label class="split-option">
					<input type="radio" name="days-per-week" value="4" data-split="pplu" />
					<span>
						<strong>4-day PPLU</strong>
						<span class="split-hint">Push · Pull · Legs · Upper</span>
					</span>
				</label>
			</div>
		</fieldset>

		<form id="week-form" class="week-form" autocomplete="off">
			{
				WEEKLY_CHECKLIST.map((group) => (
					<section class="check-group" aria-labelledby={`g-${group.id}`}>
						<h2 id={`g-${group.id}`}>{group.title}</h2>
						<ul class="check-list">
							{group.items.map((item) => (
								<li data-check-item={item.id} class={item.id === 't4' ? 'pplu-only' : undefined}>
									<label class="check-row" for={item.id}>
										<input type="checkbox" id={item.id} name={item.id} data-check-id={item.id} />
										<span class="check-copy">
											<span class="check-label">{item.label}</span>
											{item.hint ? <span class="check-hint">{item.hint}</span> : null}
										</span>
									</label>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</form>

		<section class="week-next">
			<p class="eyebrow">Tied to food</p>
			<h2>Weigh-ins without the spiral</h2>
			<p class="lede">
				2–3 morning weigh-ins beat daily panic. Set the calorie ballpark in Food Bro, then nudge from
				the 2–3 week trend — not Tuesday’s water weight.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="/food-bro">Open Food Bro</a>
				<a class="btn btn-secondary" href="/profile?returnTo=/start-here/weekly">Your profile</a>
				<a class="btn btn-secondary" href="/start-here/training">Training templates</a>
			</div>
		</section>
	</article>
</BaseLayout>

<script>
	import {
		profileSummaryLine,
		profileUrl,
		readProfile,
		splitToTrainingDays,
		trainingDaysToSplit,
		writeProfile,
	} from '../../lib/user-store';

	const STORAGE_KEY = 'yehbro-start-here-weekly-v1';
	const SPLIT_KEY = 'yehbro-start-here-split-v1';

	type WeekState = {
		weekId: string;
		checked: Record<string, boolean>;
	};

	type SplitId = 'ppl' | 'pplu';

	function currentWeekId(): string {
		const now = new Date();
		const utc = new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
		const day = utc.getUTCDay() || 7;
		utc.setUTCDate(utc.getUTCDate() + 4 - day);
		const yearStart = new Date(Date.UTC(utc.getUTCFullYear(), 0, 1));
		const week = Math.ceil(((utc.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
		return `${utc.getUTCFullYear()}-W${String(week).padStart(2, '0')}`;
	}

	function load(): WeekState {
		const weekId = currentWeekId();
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (raw) {
				const parsed = JSON.parse(raw) as WeekState;
				if (parsed.weekId === weekId && parsed.checked) return parsed;
			}
		} catch {
			/* ignore */
		}
		return { weekId, checked: {} };
	}

	function save(state: WeekState) {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
	}

	function loadSplit(): SplitId {
		const profile = readProfile();
		if (profile?.trainingDays === 3 || profile?.trainingDays === 4) {
			return trainingDaysToSplit(profile.trainingDays);
		}
		try {
			const raw = localStorage.getItem(SPLIT_KEY);
			if (raw === 'pplu' || raw === 'ppl') return raw;
		} catch {
			/* ignore */
		}
		return 'ppl';
	}

	function saveSplit(split: SplitId) {
		localStorage.setItem(SPLIT_KEY, split);
		writeProfile({ trainingDays: splitToTrainingDays(split) });
	}

	const profileLink = document.getElementById('week-profile-link');
	const profile = readProfile();
	if (profileLink) {
		if (profile) {
			profileLink.innerHTML = `Profile: ${profileSummaryLine(profile)} · <a href="${profileUrl('/start-here/weekly')}">Edit</a>`;
		} else {
			profileLink.innerHTML = `No profile yet — <a href="${profileUrl('/start-here/weekly')}">set training days once</a> so Food Bro and this checklist stay aligned.`;
		}
	}

	const state = load();
	const form = document.getElementById('week-form');
	const boxes = document.querySelectorAll<HTMLInputElement>('[data-check-id]');

	function updateStatus() {
		const visible = [...document.querySelectorAll<HTMLInputElement>('[data-check-id]')].filter(
			(b) => {
				const row = b.closest('[data-check-item]');
				return !row || !row.hasAttribute('hidden');
			},
		);
		const total = visible.length;
		const done = visible.filter((b) => b.checked).length;
		const el = document.getElementById('week-status');
		if (el) {
			el.textContent = `${state.weekId.replace('-', ' ')} · ${done} / ${total} done`;
		}
	}

	function applySplit(split: SplitId) {
		const upperRow = document.querySelector<HTMLElement>('[data-check-item="t4"]');
		const upperBox = document.querySelector<HTMLInputElement>('#t4');
		const isPplu = split === 'pplu';
		if (upperRow) {
			upperRow.hidden = !isPplu;
			upperRow.classList.toggle('is-hidden', !isPplu);
		}
		if (upperBox && !isPplu) {
			upperBox.checked = false;
			state.checked.t4 = false;
			save(state);
		}
		document.querySelectorAll<HTMLInputElement>('input[name="days-per-week"]').forEach((radio) => {
			radio.checked = radio.dataset.split === split;
		});
		updateStatus();
	}

	boxes.forEach((box) => {
		const id = box.dataset.checkId;
		if (!id) return;
		box.checked = Boolean(state.checked[id]);
		box.addEventListener('change', () => {
			state.checked[id] = box.checked;
			save(state);
			updateStatus();
		});
	});

	applySplit(loadSplit());

	document.querySelectorAll<HTMLInputElement>('input[name="days-per-week"]').forEach((radio) => {
		radio.addEventListener('change', () => {
			if (!radio.checked) return;
			const next = radio.dataset.split === 'pplu' ? 'pplu' : 'ppl';
			saveSplit(next);
			applySplit(next);
		});
	});

	document.getElementById('week-reset')?.addEventListener('click', () => {
		state.checked = {};
		boxes.forEach((box) => {
			box.checked = false;
		});
		state.weekId = currentWeekId();
		save(state);
		updateStatus();
	});

	form?.addEventListener('submit', (e) => e.preventDefault());
</script>

<style>
	.week-page {
		padding-top: 2rem;
		padding-bottom: 3rem;
	}
	.week-profile-link {
		margin: 0.65rem 0 0;
		font-size: 0.92rem;
		max-width: 40rem;
	}
	.week-profile-link :global(a) {
		color: var(--yb-lime);
	}
	.week-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		margin: 1.5rem 0 0.5rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(242, 242, 240, 0.12);
		border-bottom: 1px solid rgba(242, 242, 240, 0.12);
	}
	.week-status {
		margin: 0;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--yb-teal);
	}
	.split-picker {
		margin: 1.25rem 0 0.5rem;
		padding: 0;
		border: 0;
		max-width: 40rem;
	}
	.split-legend {
		padding: 0;
		margin: 0 0 0.65rem;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--yb-muted);
		font-weight: 600;
	}
	.split-options {
		display: grid;
		gap: 0.5rem;
		grid-template-columns: 1fr 1fr;
	}
	@media (max-width: 520px) {
		.split-options {
			grid-template-columns: 1fr;
		}
	}
	.split-option {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.85rem 0.95rem;
		background: var(--yb-surface);
		border: 1px solid rgba(242, 242, 240, 0.1);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}
	.split-option:hover {
		border-color: rgba(200, 241, 53, 0.35);
	}
	.split-option:has(input:checked) {
		border-color: rgba(46, 230, 166, 0.45);
		background: rgba(46, 230, 166, 0.06);
	}
	.split-option:focus-within {
		border-color: var(--yb-lime);
		outline: 2px solid rgba(200, 241, 53, 0.35);
		outline-offset: 2px;
	}
	.split-option input {
		width: 1.1rem;
		height: 1.1rem;
		margin-top: 0.2rem;
		accent-color: var(--yb-lime);
		flex-shrink: 0;
	}
	.split-option strong {
		display: block;
		font-weight: 700;
		color: var(--yb-offwhite);
	}
	.split-hint {
		display: block;
		font-size: 0.88rem;
		color: var(--yb-muted);
		margin-top: 0.15rem;
	}
	.pplu-only.is-hidden,
	.pplu-only[hidden] {
		display: none;
	}
	.check-group {
		margin: 2rem 0;
		scroll-margin-top: 7.5rem;
	}
	.check-group h2 {
		margin-bottom: 0.85rem;
	}
	.check-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.5rem;
		max-width: 40rem;
	}
	.check-list li {
		margin: 0;
	}
	.check-row {
		display: flex;
		gap: 0.85rem;
		align-items: flex-start;
		padding: 0.85rem 0.95rem;
		background: var(--yb-surface);
		border: 1px solid rgba(242, 242, 240, 0.1);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}
	.check-row:hover {
		border-color: rgba(200, 241, 53, 0.35);
	}
	.check-row:focus-within {
		border-color: var(--yb-lime);
		outline: 2px solid rgba(200, 241, 53, 0.35);
		outline-offset: 2px;
	}
	.check-row input {
		width: 1.2rem;
		height: 1.2rem;
		margin-top: 0.15rem;
		accent-color: var(--yb-lime);
		flex-shrink: 0;
	}
	.check-copy {
		display: grid;
		gap: 0.15rem;
	}
	.check-label {
		font-weight: 600;
		color: var(--yb-offwhite);
	}
	.check-hint {
		font-size: 0.9rem;
		color: var(--yb-muted);
	}
	.check-row:has(input:checked) {
		border-color: rgba(46, 230, 166, 0.45);
		background: rgba(46, 230, 166, 0.06);
	}
	.check-row:has(input:checked) .check-label {
		text-decoration: line-through;
		opacity: 0.75;
	}
	.week-next {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(242, 242, 240, 0.12);
	}
</style>
