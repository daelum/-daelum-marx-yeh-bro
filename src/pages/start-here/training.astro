---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPath from '../../components/ProductPath.astro';
import { TRAINING_TEMPLATES } from '../../data/start-here-system';
---

<BaseLayout
	title="Training templates — Yeh Bro System"
	description="Full body 3× and Upper/Lower 4× templates with sets, reps, and progressive overload rules — part of Yeh Bro’s Yeh Bro System."
	canonicalPath="/start-here/training"
>
	<ProductPath
		crumbs={[
			{ href: '/start-here', label: 'Yeh Bro System' },
			{ href: '/start-here/training', label: 'Training', current: true },
			{ href: '/start-here/weekly', label: 'Weekly' },
			{ href: '/food-bro', label: 'Food Bro' },
		]}
	/>

	<article class="wrap train-page">
		<p class="eyebrow anim-rise">Yeh Bro System · Phase 2–3</p>
		<h1 class="anim-rise">Training templates</h1>
		<p class="lede anim-rise-delay">
			Pick one. Run it for months. Progressive overload (adding load or reps over time) beats a new
			split every Monday. Leave 1–3 reps in the tank on most sets.
		</p>
		<div class="cta-row anim-rise-delay-2">
			<a class="btn btn-primary" href="#full-body">Full body 3×</a>
			<a class="btn btn-secondary" href="#upper-lower">Upper / Lower 4×</a>
			<a class="btn btn-secondary" href="/start-here/weekly">Weekly checklist</a>
		</div>

		{
			TRAINING_TEMPLATES.map((tpl) => (
				<section class="tpl" id={tpl.id}>
					<p class="eyebrow">
						{tpl.daysPerWeek} days · {tpl.level}
					</p>
					<h2>{tpl.name}</h2>
					<p class="tpl-blurb">{tpl.blurb}</p>

					{tpl.days.map((day) => (
						<div class="day-block">
							<h3>{day.label}</h3>
							<table class="lift-table">
								<thead>
									<tr>
										<th scope="col">Lift</th>
										<th scope="col">Sets</th>
										<th scope="col">Reps</th>
									</tr>
								</thead>
								<tbody>
									{day.lifts.map((lift) => (
										<tr>
											<td>
												{lift.name}
												{lift.notes ? <span class="lift-note">{lift.notes}</span> : null}
											</td>
											<td>{lift.sets}</td>
											<td>{lift.reps}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					))}

					<div class="progression" id={tpl.id === 'full-body' ? 'progression' : undefined}>
						<h3>Progression rules</h3>
						<ul>
							{tpl.progression.map((rule) => (
								<li>{rule}</li>
							))}
						</ul>
					</div>
				</section>
			))
		}

		<section class="tpl-close">
			<p class="eyebrow">Next</p>
			<h2>Lock the week, then dial food</h2>
			<p class="lede">
				Put sessions on the checklist. Set calories in Food Bro once training is on the calendar —
				maintain first if you’re not sure about a cut or lean bulk yet.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="/start-here/weekly">Open weekly checklist</a>
				<a class="btn btn-secondary" href="/food-bro">Open Food Bro</a>
				<a class="btn btn-secondary" href="/blog/progressive-overload">Progressive overload guide</a>
			</div>
		</section>
	</article>
</BaseLayout>

<style>
	.train-page {
		padding-top: 2rem;
		padding-bottom: 3rem;
	}
	.tpl {
		margin-top: 3rem;
		padding-top: 1.75rem;
		border-top: 1px solid rgba(242, 242, 240, 0.12);
		scroll-margin-top: 7.5rem;
	}
	.tpl-blurb {
		max-width: 42rem;
		color: rgba(242, 242, 240, 0.88);
	}
	.day-block {
		margin: 1.75rem 0;
	}
	.day-block h3 {
		color: var(--yb-lime);
		margin-bottom: 0.65rem;
	}
	.lift-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.98rem;
	}
	.lift-table th,
	.lift-table td {
		text-align: left;
		padding: 0.65rem 0.5rem;
		border-bottom: 1px solid rgba(242, 242, 240, 0.1);
		vertical-align: top;
	}
	.lift-table th {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--yb-muted);
		font-weight: 600;
	}
	.lift-table th:nth-child(2),
	.lift-table th:nth-child(3),
	.lift-table td:nth-child(2),
	.lift-table td:nth-child(3) {
		width: 4.5rem;
		white-space: nowrap;
	}
	.lift-note {
		display: block;
		font-size: 0.88rem;
		color: var(--yb-muted);
		margin-top: 0.2rem;
	}
	.progression {
		margin-top: 1.5rem;
		padding: 1rem 0 0.25rem 0.95rem;
		border-left: 3px solid var(--yb-teal);
		max-width: 42rem;
	}
	.progression h3 {
		margin-bottom: 0.5rem;
	}
	.tpl-close {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(242, 242, 240, 0.12);
	}
	@media (max-width: 560px) {
		.lift-table th:nth-child(2),
		.lift-table th:nth-child(3),
		.lift-table td:nth-child(2),
		.lift-table td:nth-child(3) {
			width: 3.25rem;
			font-size: 0.9rem;
		}
	}
</style>
