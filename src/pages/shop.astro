---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
import { SYSTEM_HREF, SYSTEM_NAME } from '../data/products';

const title = 'Yeh Bro Shop — Coming Soon';
const description =
	'Yeh Bro Shop is coming soon — apparel, legal sports nutrition, energy drinks, and gym accessories. Same metal grit as the system.';

const categories = [
	{
		name: 'Apparel',
		line: 'Metal tees and gym kits built for the floor — not a fashion drop.',
	},
	{
		name: 'Supplements',
		line: 'Legal sports nutrition you’d actually run — creatine, protein, basics.',
	},
	{
		name: 'Energy drinks',
		line: 'Cold cans for the session. Same jagged mark. No soft-drink cosplay.',
	},
	{
		name: 'Gym accessories',
		line: 'Straps, bags, and kit that survives a dark warehouse gym.',
	},
];

const shopLd = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: 'Yeh Bro Shop — Coming Soon',
	url: new URL('/shop', SITE_URL).href,
	description,
	isPartOf: { '@type': 'WebSite', name: SITE_TITLE, url: SITE_URL },
};
---

<BaseLayout
	title={title}
	description={description}
	fullBleed
	canonicalPath="/shop"
	jsonLd={shopLd}
	ogImage="/shop/yehbro-tee-back-gym.jpg"
>
	<section class="shop-hero" aria-labelledby="shop-headline">
		<div class="shop-hero-media" aria-hidden="true">
			<picture>
				<source srcset="/shop/yehbro-tee-back-gym.webp" type="image/webp" />
				<img
					class="shop-hero-img"
					src="/shop/yehbro-tee-back-gym.jpg"
					alt=""
					width="1320"
					height="1382"
					decoding="async"
					fetchpriority="high"
				/>
			</picture>
			<div class="shop-hero-shade"></div>
			<div class="shop-hero-grit"></div>
		</div>
		<div class="wrap shop-hero-inner">
			<p class="shop-brand anim-rise">
				<span class="sr-only">Yeh Bro Shop</span>
				<span class="shop-brand-mark" aria-hidden="true">
					<BrandLogo size="hero" decorative />
				</span>
				<span class="shop-brand-word" aria-hidden="true">Shop</span>
			</p>
			<h1 id="shop-headline" class="shop-headline anim-rise-delay">Coming soon</h1>
			<p class="shop-line anim-rise-delay">
				Apparel. Legal sports nutrition. Energy drinks. Gym accessories. Built for the floor —
				not a soft launch.
			</p>
			<div class="cta-row anim-rise-delay-2">
				<a class="btn btn-primary" href={SYSTEM_HREF}>{SYSTEM_NAME}</a>
				<a
					class="btn btn-secondary"
					href="https://www.instagram.com/theyehbro/"
					rel="noopener noreferrer"
					target="_blank">Follow @theyehbro</a
				>
			</div>
		</div>
	</section>

	<section class="section wrap shop-coming">
		<p class="eyebrow">What’s coming</p>
		<h2>Four lanes. One shop.</h2>
		<p class="lede shop-coming-lede">
			No fake product grid yet — just the categories we’re building toward. Training and food stay
			free in the system while the store comes online.
		</p>
		<ul class="shop-lanes">
			{
				categories.map((cat) => (
					<li>
						<strong>{cat.name}</strong>
						<span class="muted"> — {cat.line}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="shop-atmosphere" aria-label="Yeh Bro product atmosphere">
		<picture>
			<source srcset="/shop/yehbro-shop-collage-1.webp" type="image/webp" />
			<img
				src="/shop/yehbro-shop-collage-1.jpg"
				alt="Yeh Bro tee, energy can, and gym walk — metal monochrome brand world"
				width="1254"
				height="1254"
				loading="lazy"
				decoding="async"
			/>
		</picture>
	</section>

	<section class="section-tight wrap shop-close">
		<p class="eyebrow">Meanwhile</p>
		<h2>Run the system. Watch the drop.</h2>
		<p class="lede">
			Run the free system and Food Bro now. When the shop opens, you’ll hear it on Instagram first.
		</p>
		<div class="cta-row">
			<a class="btn btn-primary" href={SYSTEM_HREF}>Open {SYSTEM_NAME}</a>
			<a class="btn btn-secondary" href="/">Back home</a>
		</div>
	</section>
</BaseLayout>

<style>
	.shop-hero {
		position: relative;
		min-height: min(100svh, 920px);
		display: flex;
		align-items: flex-end;
		padding: 6rem 0 3.75rem;
		overflow: hidden;
		border-bottom: 1px solid var(--yb-edge);
	}
	.shop-hero-media {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.shop-hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Keep the metal tee mark + headphones readable on the right plane */
		object-position: 58% 22%;
		display: block;
		max-width: none;
		transform: scale(1.05);
		animation: shop-hero-scale 18s ease-in-out infinite alternate;
		filter: grayscale(0.12) contrast(1.08) brightness(0.9);
	}
	.shop-hero-shade {
		position: absolute;
		inset: 0;
		/* Soft vignette into industrial black — copy lives left, apparel breathes right */
		background:
			linear-gradient(
				105deg,
				rgba(8, 8, 8, 0.96) 0%,
				rgba(8, 8, 8, 0.82) 30%,
				rgba(8, 8, 8, 0.28) 56%,
				rgba(8, 8, 8, 0.42) 78%,
				rgba(8, 8, 8, 0.72) 100%
			),
			linear-gradient(180deg, rgba(8, 8, 8, 0.4) 0%, transparent 26%, rgba(8, 8, 8, 0.9) 100%),
			radial-gradient(ellipse 55% 70% at 72% 40%, transparent 20%, rgba(8, 8, 8, 0.35) 100%);
	}
	.shop-hero-grit {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 45% 40% at 18% 70%, rgba(200, 241, 53, 0.07), transparent 60%),
			var(--noise);
		opacity: 0.55;
		mix-blend-mode: overlay;
		animation: shop-grit 20s ease-in-out infinite alternate;
	}
	.shop-hero-inner {
		position: relative;
		z-index: 1;
		max-width: 36rem;
		padding-bottom: 0.35rem;
	}
	.shop-brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		margin: 0 0 1.1rem;
	}
	.shop-brand-mark :global(.brand-logo--hero) {
		height: clamp(7rem, 28vh, 13.5rem);
		max-width: min(100%, 15.5rem);
		animation: shop-logo-settle 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.shop-brand-word {
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 4vw, 2.35rem);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--yb-lime);
		line-height: 1;
	}
	.shop-headline {
		margin: 0 0 0.85rem;
		font-size: clamp(2.2rem, 6.5vw, 4rem);
		max-width: 10ch;
	}
	.shop-line {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.55;
		color: rgba(242, 242, 240, 0.88);
		max-width: 32rem;
	}
	.shop-coming-lede {
		margin-bottom: 1.75rem;
	}
	.shop-lanes {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 42rem;
		display: grid;
		gap: 0;
	}
	.shop-lanes li {
		margin: 0;
		padding: 1rem 0;
		border-bottom: 1px solid var(--yb-edge);
		color: var(--yb-offwhite);
		animation: rise-in 0.7s ease both;
	}
	.shop-lanes li:nth-child(1) {
		animation-delay: 0.05s;
	}
	.shop-lanes li:nth-child(2) {
		animation-delay: 0.12s;
	}
	.shop-lanes li:nth-child(3) {
		animation-delay: 0.19s;
	}
	.shop-lanes li:nth-child(4) {
		animation-delay: 0.26s;
	}
	.shop-lanes strong {
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-weight: 400;
	}
	.shop-atmosphere {
		position: relative;
		width: 100%;
		max-height: min(72vh, 720px);
		overflow: hidden;
		border-top: 1px solid var(--yb-edge);
		border-bottom: 1px solid var(--yb-edge);
		background: var(--yb-black);
	}
	.shop-atmosphere img {
		display: block;
		width: 100%;
		height: min(72vh, 720px);
		object-fit: cover;
		object-position: center 35%;
		max-width: none;
		filter: grayscale(0.2) contrast(1.05);
	}
	.shop-atmosphere::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(8, 8, 8, 0.2), transparent 30%, rgba(8, 8, 8, 0.55)),
			var(--noise);
		opacity: 0.65;
		pointer-events: none;
	}
	.shop-close {
		border-bottom: 1px solid var(--yb-edge);
	}
	@keyframes shop-hero-scale {
		from {
			transform: scale(1.05);
		}
		to {
			transform: scale(1.1);
		}
	}
	@keyframes shop-grit {
		from {
			opacity: 0.45;
		}
		to {
			opacity: 0.65;
		}
	}
	@keyframes shop-logo-settle {
		from {
			transform: translateY(16px) scale(0.97);
			opacity: 0.8;
		}
		to {
			transform: translateY(0) scale(1);
			opacity: 1;
		}
	}
	@media (max-width: 720px) {
		.shop-hero {
			align-items: flex-end;
			min-height: min(100svh, 860px);
			padding-top: 5rem;
		}
		.shop-hero-img {
			object-position: 68% 18%;
		}
		.shop-hero-shade {
			background:
				linear-gradient(
					180deg,
					rgba(8, 8, 8, 0.42) 0%,
					rgba(8, 8, 8, 0.2) 32%,
					rgba(8, 8, 8, 0.94) 80%
				),
				linear-gradient(90deg, rgba(8, 8, 8, 0.5), transparent 72%);
		}
		.shop-brand-mark :global(.brand-logo--hero) {
			max-width: min(100%, 12.5rem);
			height: clamp(6.5rem, 26vh, 11rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.shop-hero-img,
		.shop-hero-grit,
		.shop-brand-mark :global(.brand-logo--hero),
		.shop-lanes li {
			animation: none;
		}
		.shop-hero-img {
			transform: none;
		}
	}
</style>
