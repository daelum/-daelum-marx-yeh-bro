---
import '../../styles/global.css';
import { SITE_TITLE } from '../../consts';
import {
	FIXTURE_DATE,
	buildFixtureDay,
	summarizeDay,
} from '../../lib/admin-social/client-fixtures';

const fixtureDay = buildFixtureDay(FIXTURE_DATE);
const fixtureBoot = {
	date: FIXTURE_DATE,
	day: fixtureDay,
	days: [summarizeDay(fixtureDay)],
};
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Social approve · {SITE_TITLE}</title>
		<meta name="description" content="Private Instagram queue approve/reject for Yeh Bro." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="admin-body">
		<div id="app" class="admin-shell" data-state="boot">
			<header class="admin-top">
				<div class="brand-lock">
					<img src="/brand/yehbro-logo-nav.webp" alt="" width="120" height="28" />
					<span class="brand-sub">Social queue · @theyehbro</span>
				</div>
				<div class="top-meta" id="top-meta" hidden></div>
			</header>

			<section id="view-setup" class="panel" hidden>
				<h1>Setup required</h1>
				<p id="setup-copy">
					Set the Cloudflare secret <code>ADMIN_SOCIAL_PASSWORD</code>, bind KV
					<code>IG_QUEUE</code> and R2 <code>IG_MEDIA</code>, then redeploy. This gate stays
					closed until the password exists.
				</p>
				<p class="hint">
					Local demo without bindings: open <code>/admin/social?fixture=1</code>
				</p>
			</section>

			<section id="view-login" class="panel" hidden>
				<h1>Approve desk</h1>
				<p class="lede">Password gate for Instagram singles + carousels. Not linked in public nav.</p>
				<form id="login-form" class="login-form">
					<label>
						<span class="sr-only">Password</span>
						<input
							type="password"
							name="password"
							id="password"
							autocomplete="current-password"
							placeholder="Admin password"
							required
						/>
					</label>
					<button type="submit" class="btn btn-primary">Enter</button>
				</form>
				<p id="login-error" class="error" hidden></p>
				<p class="hint">
					Local demo only: <a href="/admin/social?fixture=1">open fixture mode</a>
					(<code>?fixture=1</code>). Live desk never auto-falls back to fixture.
				</p>
			</section>

			<section id="view-desk" class="desk" hidden>
				<div class="desk-bar">
					<label class="day-picker">
						<span>Day</span>
						<select id="day-select"></select>
					</label>
					<div class="desk-actions">
						<button type="button" class="btn btn-ghost" id="btn-logout">Log out</button>
					</div>
				</div>
				<p id="desk-banner" class="banner" hidden></p>
				<p id="desk-status" class="status-line" aria-live="polite"></p>

				<section class="block">
					<h2>Singles</h2>
					<div id="singles-grid" class="grid"></div>
					<p id="singles-empty" class="empty-line" hidden>No singles for this day.</p>
				</section>

				<section class="block">
					<h2>Carousels</h2>
					<div id="carousels-list" class="carousels"></div>
					<p id="carousels-empty" class="empty-line" hidden>No carousels for this day.</p>
				</section>
			</section>
		</div>

		<script is:inline define:vars={{ fixtureBoot }}>
			window.__YB_FIXTURE__ = fixtureBoot;
		</script>
		<script>
			type ItemStatus = 'pending' | 'approved' | 'rejected' | 'posted' | 'failed';
			type QueueItem = {
				id: string;
				kind: 'single' | 'carousel';
				status: ItemStatus;
				caption: string;
				angle?: string;
				files: string[];
				slides?: string[];
				mediaUrls: string[];
				failReason?: string;
				igUrl?: string;
			};
			type Day = {
				date: string;
				account: string;
				updatedAt: string;
				items: QueueItem[];
				publishLog?: string[];
			};
			type DaySummary = {
				date: string;
				pending: number;
				approved: number;
				rejected: number;
				posted: number;
				failed: number;
				total: number;
			};

			const boot = (window as any).__YB_FIXTURE__ as {
				date: string;
				day: Day;
				days: DaySummary[];
			};

			const params = new URLSearchParams(location.search);
			const forceFixture = params.get('fixture') === '1';

			let mode: 'live' | 'fixture' = forceFixture ? 'fixture' : 'live';
			let zernio = false;
			let bindingsOk = false;
			let currentDate = boot.date;
			let day: Day | null = forceFixture ? structuredClone(boot.day) : null;
			let days: DaySummary[] = forceFixture ? structuredClone(boot.days) : [];
			/** blob: object URLs created for authenticated media — revoke on re-render */
			const blobUrls = new Set<string>();
			/** Blocks double-submit while any approve/post is in flight. */
			let busy = false;

			const els = {
				app: document.getElementById('app')!,
				setup: document.getElementById('view-setup')!,
				setupCopy: document.getElementById('setup-copy')!,
				login: document.getElementById('view-login')!,
				desk: document.getElementById('view-desk')!,
				topMeta: document.getElementById('top-meta')!,
				loginForm: document.getElementById('login-form') as HTMLFormElement,
				loginError: document.getElementById('login-error')!,
				daySelect: document.getElementById('day-select') as HTMLSelectElement,
				singles: document.getElementById('singles-grid')!,
				singlesEmpty: document.getElementById('singles-empty')!,
				carousels: document.getElementById('carousels-list')!,
				carouselsEmpty: document.getElementById('carousels-empty')!,
				banner: document.getElementById('desk-banner')!,
				status: document.getElementById('desk-status')!,
				btnLogout: document.getElementById('btn-logout') as HTMLButtonElement,
			};

			function setBusy(next: boolean) {
				busy = next;
				els.app.dataset.busy = next ? '1' : '0';
				els.daySelect.disabled = next;
				els.desk.querySelectorAll('button[data-action]').forEach((node) => {
					const btn = node as HTMLButtonElement;
					if (next) {
						btn.disabled = true;
						return;
					}
					const id = btn.dataset.id;
					const item = day?.items.find((i) => i.id === id);
					if (!item) {
						btn.disabled = true;
						return;
					}
					if (btn.dataset.action === 'approve') {
						btn.disabled = item.status === 'posted' || item.status === 'rejected';
					} else if (btn.dataset.action === 'reject') {
						btn.disabled = item.status === 'posted' || item.status === 'rejected';
					}
				});
			}

			function show(view: 'setup' | 'login' | 'desk') {
				els.setup.hidden = view !== 'setup';
				els.login.hidden = view !== 'login';
				els.desk.hidden = view !== 'desk';
				els.app.dataset.state = view;
			}

			function setBanner(text: string | null, kind: 'info' | 'ok' | 'warn' | 'fixture' = 'info') {
				if (!text) {
					els.banner.hidden = true;
					els.banner.textContent = '';
					delete els.banner.dataset.kind;
					return;
				}
				els.banner.hidden = false;
				els.banner.dataset.kind = kind;
				els.banner.textContent = text;
			}

			function setStatus(text: string) {
				els.status.textContent = text;
			}

			function showBindingsRequired(message?: string) {
				els.setupCopy.innerHTML =
					message ||
					`Logged in, but this Worker is missing <code>IG_QUEUE</code> (KV) and/or <code>IG_MEDIA</code> (R2). Live queue data is in Cloudflare — bind those names on the Worker that serves yehbro.com, redeploy, then hard-refresh <code>/admin/social</code> (no <code>?fixture=1</code>).`;
				show('setup');
				els.topMeta.hidden = false;
				els.topMeta.textContent = 'LIVE · bindings required';
			}

			function showApiError(message: string) {
				els.setupCopy.textContent = message;
				show('setup');
			}

			async function api(path: string, init: RequestInit = {}) {
				const headers: Record<string, string> = {
					Accept: 'application/json',
					...(init.body ? { 'Content-Type': 'application/json' } : {}),
				};
				const extra = init.headers;
				if (extra && typeof extra === 'object' && !(extra instanceof Headers)) {
					Object.assign(headers, extra as Record<string, string>);
				}
				const res = await fetch(`/admin/social/api${path}`, {
					...init,
					credentials: 'same-origin',
					headers,
				});
				let data: any = null;
				try {
					data = await res.json();
				} catch {
					data = null;
				}
				return { res, data };
			}

			function summarize(d: Day): DaySummary {
				const counts = { pending: 0, approved: 0, rejected: 0, posted: 0, failed: 0 };
				for (const item of d.items) {
					if (item.status in counts) (counts as any)[item.status]++;
				}
				return { date: d.date, total: d.items.length, ...counts };
			}

			function refreshDaySelect() {
				els.daySelect.innerHTML = '';
				for (const d of days) {
					const opt = document.createElement('option');
					opt.value = d.date;
					opt.textContent = `${d.date} · ${d.pending} pending · ${d.approved} approved · ${d.total} total`;
					if (d.date === currentDate) opt.selected = true;
					els.daySelect.appendChild(opt);
				}
			}

			function statusClass(s: ItemStatus) {
				return `st-${s}`;
			}

			function revokeBlobs() {
				for (const url of blobUrls) URL.revokeObjectURL(url);
				blobUrls.clear();
			}

			/** Load authenticated media via cookie credentials → blob URL (Safari-safe). */
			async function authMediaSrc(url: string): Promise<string> {
				if (!url) return '';
				if (url.startsWith('data:') || url.startsWith('blob:')) return url;
				try {
					const res = await fetch(url, {
						credentials: 'same-origin',
						headers: { Accept: 'image/*,*/*' },
					});
					if (!res.ok) throw new Error(`media ${res.status}`);
					const blob = await res.blob();
					const obj = URL.createObjectURL(blob);
					blobUrls.add(obj);
					return obj;
				} catch {
					return '';
				}
			}

			function mountAuthImg(img: HTMLImageElement, url: string, fallbackLabel: string) {
				img.alt = fallbackLabel;
				img.loading = 'lazy';
				img.decoding = 'async';
				img.referrerPolicy = 'same-origin';
				img.classList.add('media-pending');
				void authMediaSrc(url).then((src) => {
					img.classList.remove('media-pending');
					if (src) {
						img.src = src;
					} else {
						img.removeAttribute('src');
						img.classList.add('media-broken');
						img.alt = `${fallbackLabel} (failed to load)`;
					}
				});
			}

			function render() {
				if (!day) return;
				revokeBlobs();
				refreshDaySelect();
				const singles = day.items.filter((i) => i.kind === 'single');
				const carousels = day.items.filter((i) => i.kind === 'carousel');
				const counts = summarize(day);

				els.topMeta.hidden = false;
				if (mode === 'fixture') {
					els.topMeta.textContent = `FIXTURE · sample · ${counts.total} items · not live KV`;
				} else {
					els.topMeta.textContent = `LIVE · ${counts.pending} pending · ${counts.approved} approved · ${counts.failed} failed · ${counts.posted} posted · ${counts.total} items`;
				}

				els.singles.innerHTML = '';
				for (const item of singles) {
					els.singles.appendChild(renderSingle(item));
				}
				els.singlesEmpty.hidden = singles.length > 0;

				els.carousels.innerHTML = '';
				for (const item of carousels) {
					els.carousels.appendChild(renderCarousel(item));
				}
				els.carouselsEmpty.hidden = carousels.length > 0;

				if (!busy) {
					setStatus(
						`${mode === 'fixture' ? 'FIXTURE · ' : 'LIVE · '}${day.date} · ${day.items.length} items · updated ${day.updatedAt}`,
					);
				}
			}

			function renderSingle(item: QueueItem) {
				const card = document.createElement('article');
				card.className = `item ${statusClass(item.status)}`;
				card.dataset.id = item.id;

				const title = document.createElement('div');
				title.className = 'item-id';
				title.textContent = item.id;

				const img = document.createElement('img');
				mountAuthImg(img, item.mediaUrls[0] || '', `Single ${item.id}`);

				const meta = document.createElement('div');
				meta.className = 'meta';
				meta.innerHTML = `<span class="pill ${statusClass(item.status)}">${item.status}</span>${item.angle ? `<span class="angle">${escapeHtml(item.angle)}</span>` : ''}`;

				const cap = document.createElement('p');
				cap.className = 'caption';
				cap.textContent = item.caption;

				if (item.failReason) {
					const err = document.createElement('p');
					err.className = 'fail-reason';
					err.textContent = item.failReason;
					card.append(title, img, meta, cap, err, itemActions(item));
					return card;
				}

				card.append(title, img, meta, cap, itemActions(item));
				return card;
			}

			function renderCarousel(item: QueueItem) {
				const card = document.createElement('article');
				card.className = `item carousel ${statusClass(item.status)}`;
				card.dataset.id = item.id;

				const head = document.createElement('div');
				head.className = 'carousel-head';
				head.innerHTML = `<span class="item-id">${item.id}</span><span class="pill ${statusClass(item.status)}">${item.status}</span>`;

				const viewer = document.createElement('div');
				viewer.className = 'carousel-viewer';
				viewer.tabIndex = 0;
				viewer.setAttribute('role', 'region');
				viewer.setAttribute('aria-label', `${item.id} slides`);

				const track = document.createElement('div');
				track.className = 'carousel-track';

				const urls = item.mediaUrls.length ? item.mediaUrls : [];
				const total = Math.max(urls.length, 1);
				urls.forEach((url, i) => {
					const slide = document.createElement('figure');
					slide.className = 'carousel-slide';
					slide.dataset.index = String(i);
					const img = document.createElement('img');
					mountAuthImg(img, url, `${item.id} slide ${i + 1}`);
					const figcap = document.createElement('figcaption');
					figcap.textContent = item.slides?.[i] || `Slide ${i + 1}`;
					slide.append(img, figcap);
					track.appendChild(slide);
				});
				if (!urls.length) {
					const empty = document.createElement('figure');
					empty.className = 'carousel-slide media-broken';
					empty.textContent = 'No slides';
					track.appendChild(empty);
				}

				const chrome = document.createElement('div');
				chrome.className = 'carousel-chrome';
				const prev = document.createElement('button');
				prev.type = 'button';
				prev.className = 'btn carousel-nav';
				prev.textContent = 'Prev';
				prev.setAttribute('aria-label', 'Previous slide');
				const counter = document.createElement('span');
				counter.className = 'carousel-counter';
				counter.textContent = `1/${total}`;
				const next = document.createElement('button');
				next.type = 'button';
				next.className = 'btn carousel-nav';
				next.textContent = 'Next';
				next.setAttribute('aria-label', 'Next slide');
				const dots = document.createElement('div');
				dots.className = 'carousel-dots';
				for (let i = 0; i < total; i++) {
					const dot = document.createElement('button');
					dot.type = 'button';
					dot.className = 'carousel-dot' + (i === 0 ? ' is-active' : '');
					dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
					dot.dataset.goto = String(i);
					dots.appendChild(dot);
				}
				chrome.append(prev, counter, next, dots);

				let index = 0;
				const sync = () => {
					const width = viewer.clientWidth || 1;
					track.style.transform = `translateX(${-index * width}px)`;
					counter.textContent = `${index + 1}/${total}`;
					dots.querySelectorAll('.carousel-dot').forEach((d, i) => {
						d.classList.toggle('is-active', i === index);
					});
					prev.disabled = index <= 0;
					next.disabled = index >= total - 1;
				};
				const go = (i: number) => {
					index = Math.max(0, Math.min(total - 1, i));
					sync();
				};

				prev.addEventListener('click', () => go(index - 1));
				next.addEventListener('click', () => go(index + 1));
				dots.addEventListener('click', (e) => {
					const t = e.target as HTMLElement;
					const btn = t.closest('[data-goto]') as HTMLElement | null;
					if (btn?.dataset.goto != null) go(Number(btn.dataset.goto));
				});

				let startX = 0;
				let startY = 0;
				let dragging = false;
				let axis: 'x' | 'y' | null = null;
				const onDown = (x: number, y: number) => {
					dragging = true;
					axis = null;
					startX = x;
					startY = y;
				};
				const onMove = (x: number, y: number, ev?: Event) => {
					if (!dragging) return;
					const dx = x - startX;
					const dy = y - startY;
					if (!axis && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
						axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
					}
					if (axis === 'x') {
						ev?.preventDefault();
						const width = viewer.clientWidth || 1;
						track.style.transform = `translateX(${-index * width + dx}px)`;
					}
				};
				const onUp = (x: number) => {
					if (!dragging) return;
					dragging = false;
					if (axis === 'x') {
						const dx = x - startX;
						if (dx < -40) go(index + 1);
						else if (dx > 40) go(index - 1);
						else sync();
					}
					axis = null;
				};

				viewer.addEventListener(
					'touchstart',
					(e) => {
						const t = e.touches[0];
						if (t) onDown(t.clientX, t.clientY);
					},
					{ passive: true },
				);
				viewer.addEventListener(
					'touchmove',
					(e) => {
						const t = e.touches[0];
						if (t) onMove(t.clientX, t.clientY, e);
					},
					{ passive: false },
				);
				viewer.addEventListener('touchend', (e) => {
					const t = e.changedTouches[0];
					onUp(t ? t.clientX : startX);
				});
				viewer.addEventListener('mousedown', (e) => {
					onDown(e.clientX, e.clientY);
				});
				window.addEventListener('mousemove', (e) => {
					if (dragging) onMove(e.clientX, e.clientY, e);
				});
				window.addEventListener('mouseup', (e) => onUp(e.clientX));
				viewer.addEventListener('keydown', (e) => {
					if (e.key === 'ArrowLeft') go(index - 1);
					if (e.key === 'ArrowRight') go(index + 1);
				});

				requestAnimationFrame(sync);
				window.addEventListener('resize', sync, { passive: true });

				viewer.append(track);
				const frame = document.createElement('div');
				frame.className = 'carousel-frame';
				frame.append(viewer, chrome);

				const cap = document.createElement('p');
				cap.className = 'caption';
				cap.textContent = item.caption;

				if (item.failReason) {
					const err = document.createElement('p');
					err.className = 'fail-reason';
					err.textContent = item.failReason;
					card.append(head, frame, cap, err, itemActions(item));
					return card;
				}

				card.append(head, frame, cap, itemActions(item));
				return card;
			}

			function itemActions(item: QueueItem) {
				const actions = document.createElement('div');
				actions.className = 'item-actions';
				const canApprove =
					item.status === 'pending' || item.status === 'failed' || item.status === 'approved';
				const approveLabel =
					item.status === 'failed' || item.status === 'approved'
						? 'Retry post'
						: 'Approve & post';
				actions.append(
					actionBtn(approveLabel, 'approve', item.id, busy || !canApprove || item.status === 'posted'),
					actionBtn(
						'Reject',
						'reject',
						item.id,
						busy || item.status === 'rejected' || item.status === 'posted',
					),
				);
				return actions;
			}

			function actionBtn(label: string, action: string, id: string, disabled: boolean) {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = action === 'approve' ? 'btn btn-primary' : 'btn btn-danger';
				btn.textContent = label;
				btn.dataset.action = action;
				btn.dataset.id = id;
				btn.disabled = disabled;
				return btn;
			}

			function escapeHtml(s: string) {
				return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
			}

			async function approveAndPostItem(id: string): Promise<boolean> {
				if (!day) return false;
				if (mode === 'fixture') {
					const item = day.items.find((i) => i.id === id);
					if (!item || item.status === 'posted' || item.status === 'rejected') return false;
					item.status = 'approved';
					delete item.failReason;
					day.updatedAt = new Date().toISOString();
					days = [summarize(day)];
					render();
					setBanner(
						`Approved ${id} — fixture mode (no Zernio). Live desk posts to @theyehbro on Approve.`,
						'fixture',
					);
					return true;
				}
				const { res, data } = await api(`/days/${encodeURIComponent(currentDate)}`, {
					method: 'PATCH',
					body: JSON.stringify({ id, status: 'approved' }),
				});
				if (data?.bindingsRequired) {
					showBindingsRequired(data.message);
					return false;
				}
				if (!res.ok) {
					setBanner(data?.error || data?.message || `Approve & post failed for ${id}`, 'warn');
					if (data?.day) {
						day = data.day;
						render();
					}
					return false;
				}
				if (data.day) day = data.day;
				else await loadDay(currentDate);
				await loadDays();
				render();
				if (data.publishFailed || (data.reason && !data.published)) {
					setBanner(data.message || data.reason || `Publish failed for ${id}`, 'warn');
					return false;
				}
				if (data.mode === 'status') {
					setBanner(data.message || 'No change', 'info');
					return false;
				}
				if (data.mode === 'agent') {
					setBanner(data.message || `Approved ${id} — ask agent to post`, 'ok');
					return true;
				}
				if (data.published) {
					setBanner(`Posted ${id} to @theyehbro.`, 'ok');
					return true;
				}
				setBanner(data.message || `Approve & post did not publish ${id}`, 'warn');
				return false;
			}

			async function rejectItem(id: string) {
				if (!day) return;
				if (mode === 'fixture') {
					const item = day.items.find((i) => i.id === id);
					if (!item || item.status === 'posted') return;
					item.status = 'rejected';
					delete item.failReason;
					day.updatedAt = new Date().toISOString();
					days = [summarize(day)];
					render();
					return;
				}
				const { res, data } = await api(`/days/${encodeURIComponent(currentDate)}`, {
					method: 'PATCH',
					body: JSON.stringify({ id, status: 'rejected' }),
				});
				if (data?.bindingsRequired) {
					showBindingsRequired(data.message);
					return;
				}
				if (!res.ok) {
					setBanner(data?.error || 'Reject failed', 'warn');
					return;
				}
				if (data.day) day = data.day;
				else await loadDay(currentDate);
				await loadDays();
				render();
			}


			async function loadDays() {
				if (mode === 'fixture') {
					days = day ? [summarize(day)] : structuredClone(boot.days);
					return true;
				}
				const { res, data } = await api('/days');
				if (data?.bindingsRequired || res.status === 503) {
					showBindingsRequired(data?.message);
					return false;
				}
				if (!res.ok) throw new Error(data?.error || 'days failed');
				days = data.days || [];
				bindingsOk = data.bindingsOk !== false;
				// Never flip live → fixture from API; fixture is opt-in only.
				if (data.fixture === true && forceFixture) mode = 'fixture';
				return true;
			}

			async function loadDay(date: string) {
				currentDate = date;
				if (mode === 'fixture') {
					if (!day || day.date !== date) day = structuredClone(boot.day);
					day.date = date;
					render();
					return;
				}
				const { res, data } = await api(`/days/${encodeURIComponent(date)}`);
				if (data?.bindingsRequired) {
					showBindingsRequired(data.message);
					return;
				}
				if (!res.ok) {
					setBanner(data?.error || 'Could not load day', 'warn');
					return;
				}
				day = data.day;
				render();
			}

			function applyDeskBanner() {
				if (mode === 'fixture') {
					setBanner(
						'FIXTURE MODE (?fixture=1 or ADMIN_SOCIAL_FIXTURE=1) — sample queue only. Hard-refresh /admin/social with no query to load live KV/R2.',
						'fixture',
					);
					return;
				}
				setBanner(
					zernio
						? 'LIVE queue · Approve & post publishes that one item to @theyehbro (no bulk approve).'
						: 'LIVE queue · No ZERNIO_API_KEY — Approve marks that one item approved and asks the agent to post.',
					'info',
				);
			}

			async function enterDesk() {
				show('desk');
				applyDeskBanner();
				const ok = await loadDays();
				if (!ok) return;
				if (!days.length) {
					day = null;
					els.singles.innerHTML = '';
					els.carousels.innerHTML = '';
					els.singlesEmpty.hidden = false;
					els.carouselsEmpty.hidden = false;
					els.topMeta.hidden = false;
					els.topMeta.textContent = mode === 'fixture' ? 'FIXTURE · empty' : 'LIVE · no synced days';
					setBanner(
						mode === 'fixture'
							? 'Fixture day missing.'
							: 'No days in KV yet. Run scripts/sync-ig-queue-to-cf.py then refresh.',
						'warn',
					);
					setStatus('No days');
					return;
				}
				currentDate = days.find((d) => d.date === currentDate)?.date || days[0]!.date;
				await loadDay(currentDate);
			}

			async function bootLive() {
				try {
					const { res, data } = await api('/session');
					if (res.status === 503 || data?.setupRequired) {
						show('setup');
						return;
					}
					if (!res.ok) {
						showApiError(
							'Could not reach /admin/social/api/session. Confirm the Worker script is deployed (not assets-only), then retry. Fixture is opt-in only via ?fixture=1.',
						);
						return;
					}
					zernio = Boolean(data.zernio);
					bindingsOk = Boolean(data.bindingsOk);
					// Explicit server fixture flag only — never silent client fixture.
					if (data.fixture === true) {
						mode = 'fixture';
					}
					if (!data.ok) {
						show('login');
						return;
					}
					if (data.bindingsRequired && mode !== 'fixture') {
						showBindingsRequired(data.message);
						return;
					}
					await enterDesk();
				} catch {
					showApiError(
						'Network error reaching the admin API. Check connectivity / Worker deploy. Live desk will not silently show fixture data.',
					);
				}
			}

			function enterFixture(message: string) {
				mode = 'fixture';
				day = structuredClone(boot.day);
				days = [summarize(day)];
				currentDate = day.date;
				show('desk');
				setBanner(message, 'fixture');
				render();
			}

			els.loginForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				els.loginError.hidden = true;
				const password = (document.getElementById('password') as HTMLInputElement).value;
				if (forceFixture) {
					enterFixture('FIXTURE MODE (?fixture=1) — sample queue for local demo. Not live KV/R2.');
					return;
				}
				const { res, data } = await api('/login', {
					method: 'POST',
					body: JSON.stringify({ password }),
				});
				if (res.status === 503 && data?.setupRequired) {
					show('setup');
					return;
				}
				if (!res.ok) {
					els.loginError.hidden = false;
					els.loginError.textContent = data?.error || 'Login failed';
					return;
				}
				const session = await api('/session');
				zernio = Boolean(session.data?.zernio);
				bindingsOk = Boolean(session.data?.bindingsOk);
				if (session.data?.fixture) mode = 'fixture';
				if (session.data?.bindingsRequired && mode !== 'fixture') {
					showBindingsRequired(session.data.message);
					return;
				}
				await enterDesk();
			});

			els.daySelect.addEventListener('change', () => {
				void loadDay(els.daySelect.value);
			});

			els.btnLogout.addEventListener('click', async () => {
				if (busy) return;
				if (mode === 'fixture' && forceFixture) {
					show('login');
					setBanner(null);
					return;
				}
				await api('/logout', { method: 'POST' });
				show('login');
				setBanner(null);
			});

			els.desk.addEventListener('click', (e) => {
				if (busy) return;
				const t = e.target as HTMLElement;
				const btn = t.closest('button[data-action]') as HTMLButtonElement | null;
				if (!btn?.dataset.action || !btn.dataset.id) return;
				if (btn.disabled) return;
				const id = btn.dataset.id;
				if (btn.dataset.action === 'approve') {
					void (async () => {
						setBusy(true);
						try {
							await approveAndPostItem(id);
						} finally {
							setBusy(false);
						}
					})();
					return;
				}
				if (btn.dataset.action === 'reject') {
					void (async () => {
						setBusy(true);
						try {
							await rejectItem(id);
						} finally {
							setBusy(false);
						}
					})();
				}
			});

			if (forceFixture) {
				enterFixture(
					'FIXTURE MODE (?fixture=1) — sample 7-item queue. Hard-refresh /admin/social with no query for live KV/R2.',
				);
			} else {
				void bootLive();
			}
		</script>

