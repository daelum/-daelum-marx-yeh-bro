---
import type { CollectionEntry } from 'astro:content';
import ArticleMeta from '../components/ArticleMeta.astro';
import ArticleReferences from '../components/ArticleReferences.astro';
import BaseHead from '../components/BaseHead.astro';
import DisclosureNote from '../components/DisclosureNote.astro';
import EnhancedContentDisclaimer from '../components/EnhancedContentDisclaimer.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
import {
	EDITORIAL_ATTRIBUTION,
	estimateReadingMinutes,
	resolveSeoDescription,
	resolveSeoTitle,
	type ContentPillar,
	type ContentType,
} from '../lib/editorial';

type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
	/** Approximate body word count for reading time (optional). */
	wordCount?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	eyebrow,
	enhancedEducation = false,
	contentType = 'guide',
	pillar,
	attribution = EDITORIAL_ATTRIBUTION,
	references,
	relatedSlugs,
	evergreen = false,
	slug,
	wordCount,
} = Astro.props;

const seoTitle = resolveSeoTitle(Astro.props);
const seoDescription = resolveSeoDescription(Astro.props);
const readingMinutes =
	wordCount !== undefined ? estimateReadingMinutes(wordCount) : undefined;

const canonicalPath = `/blog/${slug}`;
const pageUrl = new URL(canonicalPath, SITE_URL).href;
const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: seoDescription,
	datePublished: pubDate.toISOString(),
	...(updatedDate
		? { dateModified: updatedDate.toISOString() }
		: { dateModified: pubDate.toISOString() }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
	author: { '@type': 'Organization', name: attribution, url: SITE_URL },
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: SITE_URL,
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', SITE_URL).href },
	},
	inLanguage: 'en-AU',
};
---

<!doctype html>
<html lang="en-AU">
	<head>
		<BaseHead
			title={seoTitle}
			description={seoDescription}
			ogType="article"
			canonicalPath={canonicalPath}
			jsonLd={articleLd}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article class="prose-wrap post" data-content-type={contentType} data-pillar={pillar}>
				<ArticleMeta
					pubDate={pubDate}
					updatedDate={updatedDate}
					contentType={contentType as ContentType}
					pillar={pillar as ContentPillar | undefined}
					attribution={attribution}
					readingMinutes={readingMinutes}
					evergreen={evergreen}
					eyebrow={eyebrow}
				>
					<h1 slot="title">{title}</h1>
					<p class="lede" slot="lede">{description}</p>
				</ArticleMeta>
				{enhancedEducation ? <EnhancedContentDisclaimer /> : <DisclosureNote compact />}
				{
					contentType === 'technical' && !(references && references.length > 0) && (
						<aside class="evidence-posture" role="note">
							<p>
								<strong>Evidence posture:</strong> claims below are labelled in prose as
								established, emerging, limited, or opinion. We don’t invent studies or authors
								to fill a reference list.
							</p>
						</aside>
					)
				}
				<div class="post-body">
					<slot />
				</div>
				<ArticleReferences references={references} />
				<RelatedGuides slug={slug} relatedSlugs={relatedSlugs} />
				<p class="post-foot muted">
					{enhancedEducation ? (
						<>
							Education, not a personal protocol.{' '}
							<a href="/blog/ped-harm-reduction-australia">PED guide</a>
							{' · '}
							<a href="/start-here">Yeh Bro System</a>
							{' · '}
							<a href="/disclosure">Disclosure</a>
						</>
					) : (
						<>
							Not medical advice.{' '}
							<a href="/start-here">Yeh Bro System</a>
							{' · '}
							<a href="/disclosure">Disclosure</a>
						</>
					)}
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post {
		padding: 2.5rem 0 4rem;
	}
	.post-body :global(h2) {
		margin-top: 2.25rem;
	}
	.post-body :global(h3) {
		margin-top: 1.5rem;
		color: var(--yb-teal);
	}
	.post-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
		margin: 1.25rem 0 1.75rem;
	}
	.post-body :global(th),
	.post-body :global(td) {
		border-bottom: 1px solid rgba(242, 242, 240, 0.12);
		padding: 0.65rem 0.4rem;
		text-align: left;
		vertical-align: top;
	}
	.post-body :global(th) {
		color: var(--yb-lime);
		font-weight: 700;
	}
	.post-body :global(a[href^='/go/']) {
		font-weight: 600;
	}
	.evidence-posture {
		margin: 0.75rem 0 1.25rem;
		padding: 0.75rem 0 0.75rem 0.95rem;
		border-left: 3px solid var(--yb-teal);
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--yb-muted);
	}
	.evidence-posture p {
		margin: 0;
	}
	.evidence-posture strong {
		color: var(--yb-offwhite);
	}
	.post-foot {
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(242, 242, 240, 0.12);
		font-size: 0.92rem;
	}
	@media (max-width: 640px) {
		.post {
			padding: 1.75rem 0 3rem;
		}
		.post-body :global(table) {
			font-size: 0.88rem;
			display: block;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
		}
	}
</style>
